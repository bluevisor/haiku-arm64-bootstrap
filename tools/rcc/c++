#!/bin/bash
# Guest-side c++ wrapper for tools/rcc/rcc-server.py: preprocess here, compile
# the .ii with the identical GCC 13.3 cross compiler on the host. Put its
# directory first in PATH (build systems keep calling plain `c++`, so ninja
# sees unchanged command lines and rebuilds nothing):
#   PATH=/boot/home/rcc/bin:$PATH ninja -j16 ...
# Anything that is not a plain `-c ... -o OUT` compile, or that the server
# can't take, runs the real compiler here.
REAL=${RCC_REAL:-/boot/system/bin/c++}
URL=${RCC_URL:-http://192.168.64.1:8766/compile}
args=("$@") pre=() flags=() mt=() out= compile=0

for ((i = 0; i < ${#args[@]}; i++)); do
	a=${args[i]}
	case $a in
	-c) compile=1; continue ;;
	-o) out=${args[i + 1]}; i=$((i + 1)); continue ;;
	-MD|-MMD) mt=(-MT "") ;;
	-E|-S|-M|-MM|-x|-|-fplugin*|-Wl,*|-Wa,*|-Wp,*|@*) exec "$REAL" "$@" ;;
	-O*|-std=*|-f*|-m*|-W*|-w|-g*|-pthread) flags+=("$a") ;;
	esac
	pre+=("$a")
done
[ $compile = 1 ] && [ -n "$out" ] || exec "$REAL" "$@"

ii=$(mktemp /tmp/rcc.XXXXXXXX)
# -MT: with -E the depfile would otherwise name the .ii as its target
[ ${#mt[@]} -eq 0 ] || mt=(-MT "$out")
if ! "$REAL" "${pre[@]}" "${mt[@]}" -E -o "$ii"; then
	rm -f "$ii"
	exit 1
fi
code=$(curl -s -o "$out.rcc" -w '%{http_code}' -H "X-Flags: ${flags[*]}" \
	-H 'Content-Type: application/octet-stream' --data-binary @"$ii" "$URL")
rm -f "$ii"
case $code in
200) mv "$out.rcc" "$out"; exit 0 ;;
422) cat "$out.rcc" >&2; rm -f "$out.rcc"; exit 1 ;;
esac
rm -f "$out.rcc"
exec "$REAL" "$@"
