+
+void
+QuickLookWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kQuickLookShow:
+		{
+			entry_ref ref;
+			BRect iconFrame;
+			if (message->FindRect("frame", &iconFrame) != B_OK)
+				iconFrame = BRect();
+			if (_ChangePending()) {
+				// the selection moved on already, or a close is waiting:
+				// skip straight to it
+				break;
+			}
+			if (message->FindRef("refs", &ref) == B_OK)
+				_Show(ref, iconFrame);
+			break;
+		}
+
+		case kQuickLookClose:
+		{
+			BRect iconFrame;
+			if (message->FindRect("frame", &iconFrame) != B_OK)
+				iconFrame = fIconFrame;
+			_Close(iconFrame, message->GetBool("quit", false));
+			break;
+		}
+
+		default:
+			BWindow::MessageReceived(message);
+	}
+}
+
+
+void
+QuickLookWindow::_Show(const entry_ref& ref, BRect iconFrame)
+{
+	if (iconFrame.IsValid())
+		fIconFrame = iconFrame;
+	if (ref == fRef && ChildAt(0) != NULL)
+		return;
+	fRef = ref;
+	SetTitle(ref.name);
+
+	BEntry entry(&ref, true);
+	BScreen screen(this);
+	BRect screenFrame = screen.Frame();
+	float maxWidth = floorf(screenFrame.Width() * 0.7f);
+	float maxHeight = floorf(screenFrame.Height() * 0.7f);
+
+	if (!entry.IsDirectory()) {
+		BFile file(&entry, B_READ_ONLY);
+		char type[B_MIME_TYPE_LENGTH] = "";
+		BNodeInfo(&file).GetType(type);
+
+		if (strncmp(type, "text/", 5) != 0) {
+			entry_ref target;
+			entry.GetRef(&target);
+			BBitmap* bitmap = BTranslationUtils::GetBitmap(&target);
+			if (bitmap != NULL) {
+				// Translators that byte-swap their header floats get garbage
+				// bounds from libroot's broken arm64 __swap_float.
+				BRect bounds = bitmap->Bounds();
+				if (!std::isfinite(bounds.Width())
+					|| !std::isfinite(bounds.Height())
+					|| bounds.Width() < 0 || bounds.Height() < 0
+					|| bounds.Width() > 32767 || bounds.Height() > 32767
+					|| bitmap->InitCheck() != B_OK) {
+					delete bitmap;
+					bitmap = NULL;
+				}
+			}
+			if (bitmap != NULL) {
+				BRect bounds = bitmap->Bounds();
+				float scale = std::min(1.0f, std::min(
+					maxWidth / (bounds.Width() + 1),
+					maxHeight / (bounds.Height() + 1)));
+				float width = std::max(240.0f, (bounds.Width() + 1) * scale);
+				float height = std::max(160.0f, (bounds.Height() + 1) * scale);
+				_SetContent(new ImageView(bitmap), width, height);
+				return;
+			}
+		}
+
+		translator_info info;
+		bool isImage = file.InitCheck() == B_OK
+			&& BTranslatorRoster::Default()->Identify(&file, NULL, &info, 0,
+				NULL, B_TRANSLATOR_BITMAP) == B_OK;
+		if (!isImage && file.InitCheck() == B_OK
+			&& looks_like_text(type, file)) {
+			off_t size = 0;
+			file.GetSize(&size);
+			size = std::min(size, kMaxTextBytes);
+			BString text;
+			char* buffer = text.LockBuffer(size + 1);
+			ssize_t bytesRead = file.ReadAt(0, buffer, size);
+			text.UnlockBuffer(bytesRead > 0 ? bytesRead : 0);
+
+			BRect rect(0, 0, kTextWidth, kTextHeight);
+			BTextView* textView = new BTextView(rect, "text",
+				rect.InsetByCopy(6, 6), B_FOLLOW_ALL, B_WILL_DRAW);
+			textView->SetFontAndColor(be_fixed_font);
+			textView->SetText(text);
+			textView->MakeEditable(false);
+			textView->SetWordWrap(true);
+			BScrollView* scrollView = new BScrollView("scroll", textView,
+				B_FOLLOW_ALL, 0, false, true, B_NO_BORDER);
+			_SetContent(scrollView, kTextWidth, kTextHeight);
+			return;
+		}
+	}
+
+	_SetContent(new InfoView(ref), kInfoWidth, kInfoHeight);
+}
+
+
+void
+QuickLookWindow::_SetContent(BView* view, float width, float height)
+{
+	if (!std::isfinite(width) || !std::isfinite(height)) {
+		width = kInfoWidth;
+		height = kInfoHeight;
+	}
+
+	if (_ChangePending()) {
+		// the selection moved on while this file was loading
+		delete view;
+		return;
+	}
+
+	BBitmap* previous = NULL;
+	while (BView* child = ChildAt(0)) {
+		RemoveChild(child);
+		if (fOpened && previous == NULL && !IsHidden())
+			previous = _Snapshot(child);
+		delete child;
+	}
+
+	// always centered on the screen, like Quick Look on macOS
+	BScreen screen(this);
+	BRect screenFrame = screen.Frame();
+	BPoint center(screenFrame.left + screenFrame.Width() / 2,
+		screenFrame.top + screenFrame.Height() / 2);
+	BPoint topLeft(floorf(center.x - width / 2), floorf(center.y - height / 2));
+	topLeft.x = std::max(screenFrame.left + 4,
+		std::min(topLeft.x, screenFrame.right - width - 4));
+	topLeft.y = std::max(screenFrame.top + 24,
+		std::min(topLeft.y, screenFrame.bottom - height - 4));
+	BRect target(topLeft, topLeft + BPoint(width, height));
+
+	view->ResizeTo(width, height);
+
+	bool completed = true;
+	if (!fOpened) {
+		// zoom out of the icon, like Quick Look on macOS
+		fOpened = true;
+		BRect from = fIconFrame.IsValid() ? fIconFrame
+			: BRect(target.LeftTop() + BPoint(width / 2 - 16, height / 2 - 16),
+				target.LeftTop() + BPoint(width / 2 + 16, height / 2 + 16));
+		BBitmap* snapshot = _Snapshot(view);
+		if (snapshot != NULL)
+			completed = _Zoom(snapshot, from, target, true);
+	} else if (previous != NULL) {
+		// another file: resize to it while crossfading the content
+		BBitmap* snapshot = _Snapshot(view);
+		if (snapshot != NULL)
+			completed = _Morph(previous, snapshot, Frame(), target);
+		else
+			delete previous;
+	}
+
+	if (completed) {
+		MoveTo(target.LeftTop());
+		ResizeTo(width, height);
+	} else {
+		// Interrupted by the next file or a close: stay where the animation
+		// got to, so the next transition starts from here.
+		view->ResizeTo(Bounds().Width(), Bounds().Height());
+	}
+	AddChild(view);
+	if (IsHidden())
+		Show();
+}
+
+
+/*!	The window avoids focus, but if it gets the keyboard anyway (shown again,
+	clicked), it must not swallow the Quick Look keys: space and Escape close
+	it, everything else (arrow keys, type-ahead) goes on to the Tracker
+	window.
+*/
+void
+QuickLookWindow::DispatchMessage(BMessage* message, BHandler* target)
+{
+	if ((message->what == B_KEY_DOWN || message->what == B_UNMAPPED_KEY_DOWN)
+		&& fPoseView.IsValid()) {
+		const char* bytes = NULL;
+		int32 modifiers = 0;
+		message->FindString("bytes", &bytes);
+		message->FindInt32("modifiers", &modifiers);
+		bool plain = (modifiers & (B_SHIFT_KEY | B_COMMAND_KEY | B_CONTROL_KEY
+			| B_OPTION_KEY)) == 0;
+		if (bytes != NULL && plain
+			&& (bytes[0] == B_SPACE || bytes[0] == B_ESCAPE)) {
+			_Close(fIconFrame, false);
+			fPoseView.SendMessage(kQuickLookHidden);
+		} else
+			fPoseView.SendMessage(message);
+		return;
+	}
+	if (message->what == B_KEY_UP || message->what == B_UNMAPPED_KEY_UP)
+		return;
+
+	BWindow::DispatchMessage(message, target);
+}
+
+
+bool
+QuickLookWindow::QuitRequested()
+{
+	// The close button only hides the window, so it can be reused; app_server
+	// has trouble with windows created and destroyed in quick succession.
+	// Quitting the application still quits it.
+	BMessage* current = CurrentMessage();
+	if (current != NULL && current->what == B_QUIT_REQUESTED
+		&& fPoseView.IsValid()) {
+		_Close(fIconFrame, false);
+		fPoseView.SendMessage(kQuickLookHidden);
+		return false;
+	}
+	return true;
+}
+
+
+void
+QuickLookWindow::_Close(BRect iconFrame, bool quit)
+{
+	BView* view = ChildAt(0);
+	if (view != NULL && !IsHidden()) {
+		RemoveChild(view);
+		BBitmap* snapshot = _Snapshot(view);
+		delete view;
+		BRect frame = Frame();
+		BRect to = iconFrame.IsValid() ? iconFrame
+			: BRect(frame.LeftTop() + BPoint(frame.Width() / 2 - 16,
+					frame.Height() / 2 - 16),
+				frame.LeftTop() + BPoint(frame.Width() / 2 + 16,
+					frame.Height() / 2 + 16));
+		if (snapshot != NULL)
+			_Zoom(snapshot, frame, to, false);
+	}
+
+	if (quit) {
+		Quit();
+		return;
+	}
+
+	while (BView* child = ChildAt(0)) {
+		RemoveChild(child);
+		delete child;
+	}
+	if (!IsHidden())
+		Hide();
+	fOpened = false;
+	fRef = entry_ref();
+}
+
+
+/*!	Renders \a view (not attached to a window) into a bitmap. */
+BBitmap*
+QuickLookWindow::_Snapshot(BView* view)
+{
+	// Never attach a BScrollBar (or anything else that registers an event
+	// mask) to an offscreen bitmap: app_server adds the bitmap's offscreen
+	// window as an event target and does not remove it when the bitmap goes
+	// away, and its event loop then crashes on the dangling target (white
+	// screen). Text previews are snapshotted through a plain BTextView.
+	BView* source = view;
+	BTextView* standIn = NULL;
+	if (BScrollView* scrollView = dynamic_cast<BScrollView*>(view)) {
+		BTextView* textView = dynamic_cast<BTextView*>(scrollView->Target());
+		if (textView == NULL)
+			return NULL;
+		BRect bounds = view->Bounds();
+		standIn = new BTextView(bounds, "snapshot", bounds.InsetByCopy(6, 6),
+			B_FOLLOW_NONE, B_WILL_DRAW);
+		standIn->SetFontAndColor(be_fixed_font);
+		standIn->SetWordWrap(true);
+		// what fits on screen is plenty
+		standIn->SetText(textView->Text(),
+			std::min(textView->TextLength(), (int32)16384));
+		source = standIn;
+	}
+
+	BBitmap* bitmap = new(std::nothrow) BBitmap(source->Bounds(),
+		B_BITMAP_ACCEPTS_VIEWS, B_RGBA32);
+	if (bitmap == NULL || bitmap->InitCheck() != B_OK) {
+		delete bitmap;
+		delete standIn;
+		return NULL;
+	}
+
+	bitmap->Lock();
+	bitmap->AddChild(source);
+	draw_offscreen(source);
+	source->Sync();
+	bitmap->RemoveChild(source);
+	bitmap->Unlock();
+	delete standIn;
+	return bitmap;
+}
+
+
+/*!	Animates the window frame between \a from and \a to while showing
+	\a snapshot scaled to it. Takes ownership of the snapshot.
+*/
+bool
+QuickLookWindow::_Zoom(BBitmap* snapshot, BRect from, BRect to, bool opening)
+{
+	SnapshotView* view = new SnapshotView(snapshot);
+	while (BView* child = ChildAt(0)) {
+		RemoveChild(child);
+		delete child;
+	}
+
+	MoveTo(from.LeftTop());
+	ResizeTo(from.Width(), from.Height());
+	view->ResizeTo(from.Width(), from.Height());
+	AddChild(view);
+	if (IsHidden())
+		Show();
+	UpdateIfNeeded();
+
+	bool completed = true;
+	bigtime_t start = system_time();
+	for (int32 frame = 1; frame <= kZoomFrames; frame++) {
+		if (opening && _ChangePending()) {
+			completed = false;
+			break;
+		}
+		bigtime_t due = start + kZoomDuration * frame / kZoomFrames;
+		bigtime_t now = system_time();
+		if (due > now)
+			snooze(due - now);
+
+		float t = (float)frame / kZoomFrames;
+		t = opening ? ease_out(t) : ease_in(t);
+		BRect current(
+			from.left + (to.left - from.left) * t,
+			from.top + (to.top - from.top) * t,
+			from.right + (to.right - from.right) * t,
+			from.bottom + (to.bottom - from.bottom) * t);
+		MoveTo(floorf(current.left), floorf(current.top));
+		ResizeTo(floorf(current.Width()), floorf(current.Height()));
+		view->Invalidate();
+		UpdateIfNeeded();
+	}
+
+	RemoveChild(view);
+	delete view;
+	return completed;
+}
+
+
+/*!	Animates from one previewed file to the next: the frame moves to the new
+	size while the old picture fades into the new one, both scaled to the
+	window. Takes ownership of both snapshots.
+*/
+bool
+QuickLookWindow::_Morph(BBitmap* previous, BBitmap* snapshot, BRect from,
+	BRect to)
+{
+	SnapshotView* view = new SnapshotView(snapshot, previous);
+	view->ResizeTo(from.Width(), from.Height());
+	AddChild(view);
+	UpdateIfNeeded();
+
+	bool completed = true;
+	bigtime_t start = system_time();
+	for (int32 frame = 1; frame <= kMorphFrames; frame++) {
+		if (_ChangePending()) {
+			completed = false;
+			break;
+		}
+		bigtime_t due = start + kMorphDuration * frame / kMorphFrames;
+		bigtime_t now = system_time();
+		if (due > now)
+			snooze(due - now);
+
+		float linear = (float)frame / kMorphFrames;
+		float t = ease_out(linear);
+		BRect current(
+			from.left + (to.left - from.left) * t,
+			from.top + (to.top - from.top) * t,
+			from.right + (to.right - from.right) * t,
+			from.bottom + (to.bottom - from.bottom) * t);
+		MoveTo(floorf(current.left), floorf(current.top));
+		ResizeTo(floorf(current.Width()), floorf(current.Height()));
+		view->SetProgress(linear);
+		view->Invalidate();
+		UpdateIfNeeded();
+	}
+
+	RemoveChild(view);
+	delete view;
+	return completed;
+}
+
+
+/*!	Whether a newer file or a close is waiting. Messages sent while the
+	window animates are still in its port, so first move them into the
+	queue, in order, as the looper itself would.
+*/
+bool
+QuickLookWindow::_ChangePending()
+{
+	while (BMessage* message = MessageFromPort(0))
+		MessageQueue()->AddMessage(message);
+
+	return MessageQueue()->FindMessage(kQuickLookShow, 0) != NULL
+		|| MessageQueue()->FindMessage(kQuickLookClose, 0) != NULL;
+}
