+void
+draw_offscreen(BView* view)
+{
+	BRect bounds = view->Bounds();
+	rgb_color color = view->ViewColor();
+	if (color != B_TRANSPARENT_COLOR) {
+		view->SetHighColor(color);
+		view->FillRect(bounds);
+	}
+	view->PushState();
+	view->Draw(bounds);
+	view->PopState();
+	for (int32 i = 0; BView* child = view->ChildAt(i); i++)
+		draw_offscreen(child);
+	view->PushState();
+	view->DrawAfterChildren(bounds);
+	view->PopState();
+}
+
+
+float
+ease_out(float t)
+{
+	t = 1 - t;
+	return 1 - t * t * t;
+}
+
+
+float
+ease_in(float t)
+{
+	return t * t * t;
+}
