+class ImageView : public BView {
+public:
+	ImageView(BBitmap* bitmap)
+		:
+		BView(BRect(0, 0, 1, 1), "image", B_FOLLOW_ALL,
+			B_WILL_DRAW | B_FULL_UPDATE_ON_RESIZE),
+		fBitmap(bitmap)
+	{
+		SetViewColor(B_TRANSPARENT_COLOR);
+	}
+
+	~ImageView()
+	{
+		delete fBitmap;
+	}
+
+	void Draw(BRect updateRect)
+	{
+		BRect bounds = Bounds();
+		SetHighColor(40, 40, 40);
+		FillRect(bounds);
+
+		BRect source = fBitmap->Bounds();
+		float scale = std::min(bounds.Width() / source.Width(),
+			bounds.Height() / source.Height());
+		if (scale > 1)
+			scale = 1;
+		float width = source.Width() * scale;
+		float height = source.Height() * scale;
+		BRect target(0, 0, width, height);
+		target.OffsetTo((bounds.Width() - width) / 2,
+			(bounds.Height() - height) / 2);
+
+		SetDrawingMode(B_OP_ALPHA);
+		DrawBitmap(fBitmap, source, target, B_FILTER_BITMAP_BILINEAR);
+		SetDrawingMode(B_OP_COPY);
+	}
+
+private:
+	BBitmap*	fBitmap;
+};
