+
+/*!	A floating preview of the selected entry, toggled with the space bar in
+	a Tracker window, like Quick Look in the macOS Finder. It never takes
+	the keyboard focus, so arrow keys keep moving the selection (and the
+	preview follows), and space or Escape close it again.
+*/
+class QuickLookWindow : public BWindow {
+public:
+								QuickLookWindow(BRect screenFrame,
+									const BMessenger& poseView);
+
+	virtual	void				MessageReceived(BMessage* message);
+	virtual	bool				QuitRequested();
+	virtual	void				DispatchMessage(BMessage* message,
+									BHandler* target);
+
+private:
+			void				_Show(const entry_ref& ref, BRect iconFrame);
+			void				_Close(BRect iconFrame, bool quit);
+			void				_SetContent(BView* view, float width,
+									float height);
+			BBitmap*			_Snapshot(BView* view);
