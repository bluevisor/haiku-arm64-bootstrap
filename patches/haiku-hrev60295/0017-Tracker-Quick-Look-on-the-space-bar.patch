+
+QuickLookWindow::QuickLookWindow(BRect screenFrame,
+	const BMessenger& poseView)
+	:
+	BWindow(BRect(0, 0, kInfoWidth, kInfoHeight), B_TRANSLATE("Quick Look"),
+		B_TITLED_WINDOW_LOOK, B_FLOATING_APP_WINDOW_FEEL,
+		B_AVOID_FOCUS | B_NOT_ZOOMABLE | B_NOT_MINIMIZABLE
+			| B_ASYNCHRONOUS_CONTROLS),
+	fPoseView(poseView),
+	fOpened(false)
+{
+	// the zoom starts from icon size
+	SetSizeLimits(8, 32768, 8, 32768);
+}
