+bool
+looks_like_text(const char* type, BFile& file)
+{
+	if (strncmp(type, "text/", 5) == 0)
+		return true;
+
+	static const char* const kTextTypes[] = {
+		"application/json", "application/xml", "application/x-sh",
+		"application/x-shellscript", "application/javascript",
+		"application/x-perl", "application/x-python", NULL
+	};
+	for (int32 i = 0; kTextTypes[i] != NULL; i++) {
+		if (strcmp(type, kTextTypes[i]) == 0)
+			return true;
+	}
+	if (strncmp(type, "image/", 6) == 0 || strncmp(type, "audio/", 6) == 0
+		|| strncmp(type, "video/", 6) == 0) {
+		return false;
+	}
+
+	// untyped or generic files: text if the start is (almost) free of
+	// control bytes; raw image data or executables are not
+	uint8 buffer[4096];
+	ssize_t bytesRead = file.ReadAt(0, buffer, sizeof(buffer));
+	if (bytesRead <= 0)
+		return false;
+	int32 control = 0;
+	for (ssize_t i = 0; i < bytesRead; i++) {
+		uint8 c = buffer[i];
+		if (c == 0)
+			return false;
+		if (c < 0x20 && c != '\t' && c != '\n' && c != '\r' && c != '\f'
+			&& c != 0x1b) {
+			control++;
+		}
+	}
+	if (control * 100 > bytesRead)
+		return false;
+
+	// and mostly valid UTF-8 (raw pixel data is not)
+	int32 invalid = 0;
+	for (ssize_t i = 0; i < bytesRead;) {
+		uint8 c = buffer[i];
+		int32 length = c < 0x80 ? 1 : (c & 0xe0) == 0xc0 ? 2
+			: (c & 0xf0) == 0xe0 ? 3 : (c & 0xf8) == 0xf0 ? 4 : 0;
+		if (length == 0) {
+			invalid++;
+			i++;
+			continue;
+		}
+		bool valid = true;
+		for (int32 j = 1; j < length; j++) {
+			if (i + j >= bytesRead)
+				break;
+			if ((buffer[i + j] & 0xc0) != 0x80)
+				valid = false;
+		}
+		if (!valid)
+			invalid++;
+		i += valid ? length : 1;
+	}
+	return invalid * 100 <= bytesRead;
+}
