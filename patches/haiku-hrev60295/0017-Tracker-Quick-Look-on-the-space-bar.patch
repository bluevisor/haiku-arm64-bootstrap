+const uint32 kQuickLookShow = 'QLsh';
+	// "refs": the entry to preview, "frame": its icon on screen (the first
+	// show zooms out of it)
+const uint32 kQuickLookClose = 'QLcl';
+	// "frame": where to zoom back into (optional); the window is hidden
+	// and reused, unless "quit" is true
+const uint32 kQuickLookHidden = 'QLhd';
