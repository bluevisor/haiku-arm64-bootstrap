+/*!	Shows a picture of the real content scaled to the window while it zooms,
+	so the content scales instead of reflowing.
+*/
+class SnapshotView : public BView {
+public:
+	SnapshotView(BBitmap* bitmap, BBitmap* previous = NULL)
+		:
+		BView(BRect(0, 0, 1, 1), "snapshot", B_FOLLOW_ALL, B_WILL_DRAW),
+		fBitmap(bitmap),
+		fPrevious(previous),
+		fProgress(previous != NULL ? 0 : 1)
+	{
+		SetViewColor(B_TRANSPARENT_COLOR);
+	}
+
+	~SnapshotView()
+	{
+		delete fBitmap;
+		delete fPrevious;
+	}
+
+	//! Crossfade position from the previous picture (0) to the new one (1).
+	void SetProgress(float progress)
+	{
+		fProgress = progress;
+	}
+
+	void Draw(BRect updateRect)
+	{
+		if (fPrevious == NULL || fProgress >= 1) {
+			DrawBitmap(fBitmap, fBitmap->Bounds(), Bounds(),
+				B_FILTER_BITMAP_BILINEAR);
+			return;
+		}
+
+		DrawBitmap(fPrevious, fPrevious->Bounds(), Bounds(),
+			B_FILTER_BITMAP_BILINEAR);
+		SetDrawingMode(B_OP_ALPHA);
+		SetBlendingMode(B_CONSTANT_ALPHA, B_ALPHA_OVERLAY);
+		SetHighColor(0, 0, 0, (uint8)(fProgress * 255));
+		DrawBitmap(fBitmap, fBitmap->Bounds(), Bounds(),
+			B_FILTER_BITMAP_BILINEAR);
+		SetDrawingMode(B_OP_COPY);
+	}
+
+private:
+	BBitmap*	fBitmap;
+	BBitmap*	fPrevious;
+	float		fProgress;
+};
