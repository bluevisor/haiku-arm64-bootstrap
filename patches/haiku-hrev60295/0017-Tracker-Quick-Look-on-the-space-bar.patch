+									bool opening);
+			bool				_Morph(BBitmap* previous, BBitmap* snapshot,
+									BRect from, BRect to);
+			bool				_ChangePending();
+
+			BMessenger			fPoseView;
+			entry_ref			fRef;
+			BRect				fIconFrame;
+			bool				fOpened;
+};
