+class InfoView : public BView {
+public:
+	InfoView(const entry_ref& ref)
+		:
+		BView(BRect(0, 0, 1, 1), "info", B_FOLLOW_ALL,
+			B_WILL_DRAW | B_FULL_UPDATE_ON_RESIZE),
+		fIcon(BRect(0, 0, 127, 127), B_RGBA32)
+	{
+		SetViewUIColor(B_PANEL_BACKGROUND_COLOR);
+
+		memset(fIcon.Bits(), 0, fIcon.BitsLength());
+		BNodeInfo::GetTrackerIcon(&ref, &fIcon, (icon_size)128);
+
+		fName = ref.name;
+
+		BEntry entry(&ref, true);
+		BNode node(&entry);
+		char type[B_MIME_TYPE_LENGTH] = "";
+		BNodeInfo(&node).GetType(type);
+
+		if (entry.IsDirectory()) {
+			BDirectory directory(&entry);
+			int32 count = directory.CountEntries();
+			fKind = B_TRANSLATE("Folder");
+			fSize.SetToFormat(count == 1 ? B_TRANSLATE("%" B_PRId32 " item")
+				: B_TRANSLATE("%" B_PRId32 " items"), count);
+		} else {
+			BMimeType mime(type);
+			char description[B_MIME_TYPE_LENGTH];
+			if (type[0] != '\0'
+				&& mime.GetShortDescription(description) == B_OK) {
+				fKind = description;
+			} else
+				fKind = type[0] != '\0' ? type : B_TRANSLATE("Document");
+
+			off_t size = 0;
+			entry.GetSize(&size);
+			char sizeString[128];
+			fSize = string_for_size(size, sizeString, sizeof(sizeString));
+		}
+
+		time_t modified;
+		if (entry.GetModificationTime(&modified) == B_OK) {
+			char buffer[128];
+			strftime(buffer, sizeof(buffer), "%c", localtime(&modified));
+			fModified.SetToFormat(B_TRANSLATE("Modified %s"), buffer);
+		}
+	}
+
+	void Draw(BRect updateRect)
+	{
+		SetDrawingMode(B_OP_ALPHA);
+		DrawBitmap(&fIcon, BPoint(24, (Bounds().Height() - 128) / 2));
+		SetDrawingMode(B_OP_COPY);
+
+		float x = 24 + 128 + 24;
+		float y = (Bounds().Height() - 128) / 2 + 28;
+		SetHighUIColor(B_PANEL_TEXT_COLOR);
+
+		BFont font(be_bold_font);
+		font.SetSize(font.Size() * 1.4f);
+		SetFont(&font);
+		BString name(fName);
+		font.TruncateString(&name, B_TRUNCATE_MIDDLE, Bounds().Width() - x - 16);
+		DrawString(name, BPoint(x, y));
+
+		SetFont(be_plain_font);
+		font_height height;
+		be_plain_font->GetHeight(&height);
+		float line = ceilf(height.ascent + height.descent + height.leading) + 4;
+		y += line + 8;
+		DrawString(fKind, BPoint(x, y));
+		y += line;
+		DrawString(fSize, BPoint(x, y));
+		y += line;
+		DrawString(fModified, BPoint(x, y));
+	}
+
+private:
+	BBitmap		fIcon;
+	BString		fName;
+	BString		fKind;
+	BString		fSize;
+	BString		fModified;
+};
