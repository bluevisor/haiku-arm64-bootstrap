+bool
+BPoseView::IsQuickLookOpen() const
+{
+	return fQuickLookVisible && fQuickLook.IsValid();
+}
+
+
+/*!	The screen frame of the first selected pose's icon, for the Quick Look
+	zoom; invalid if it is scrolled out of view.
+*/
+BRect
+BPoseView::_QuickLookIconFrame()
+{
+	BPose* pose = fSelectionList->FirstItem();
+	if (pose == NULL || Window() == NULL)
+		return BRect();
+
+	BRect rect;
+	if (ViewMode() == kListMode) {
+		int32 index = CurrentPoseList()->IndexOf(pose);
+		rect = CalcPoseRectList(pose, index, true);
+		rect.right = rect.left + rect.Height();
+	} else {
+		rect = CalcPoseRectIcon(pose);
+		float size = IconSizeInt();
+		float left = rect.left + (rect.Width() - size) / 2;
+		rect.Set(left, rect.top, left + size, rect.top + size);
+	}
+	if (!Bounds().Intersects(rect))
+		return BRect();
+	return ConvertToScreen(rect);
+}
+
+
+void
+BPoseView::ToggleQuickLook()
+{
+	if (IsQuickLookOpen()) {
+		CloseQuickLook();
+		return;
+	}
+
+	BPose* pose = fSelectionList->FirstItem();
+	if (pose == NULL)
+		return;
+
+	if (!fQuickLook.IsValid()) {
+		QuickLookWindow* window = new QuickLookWindow(Window()->Frame(),
+			BMessenger(this));
+		fQuickLook = BMessenger(window);
+		// start its thread but keep it hidden: it shows itself zooming out
+		// of the icon once the content is ready
+		window->Hide();
+		window->Show();
+	}
+	fQuickLookVisible = true;
+	UpdateQuickLook();
+}
+
+
+void
+BPoseView::CloseQuickLook(bool zoomToIcon, bool quit)
+{
+	if (fQuickLook.IsValid() && (fQuickLookVisible || quit)) {
+		BMessage message(kQuickLookClose);
+		BRect frame = zoomToIcon ? _QuickLookIconFrame() : BRect();
+		if (frame.IsValid())
+			message.AddRect("frame", frame);
+		message.AddBool("quit", quit);
+		fQuickLook.SendMessage(&message);
+	}
+	fQuickLookVisible = false;
+	if (quit)
+		fQuickLook = BMessenger();
+}
+
+
+void
+BPoseView::UpdateQuickLook()
+{
+	if (!IsQuickLookOpen())
+		return;
+
+	BPose* pose = fSelectionList->FirstItem();
+	if (pose == NULL) {
+		CloseQuickLook(false);
+		return;
+	}
+
+	BMessage message(kQuickLookShow);
+	message.AddRef("refs", pose->TargetModel()->EntryRef());
+	BRect frame = _QuickLookIconFrame();
+	if (frame.IsValid())
+		message.AddRect("frame", frame);
+	fQuickLook.SendMessage(&message);
+}
