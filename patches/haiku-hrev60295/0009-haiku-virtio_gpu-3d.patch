+
+static status_t
+virtio_gpu_render_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_free(void* cookie)
+{
+	virtio_gpu_render_file* file = (virtio_gpu_render_file*)cookie;
+	virtio_gpu_driver_info* info = file->info;
+
+	{
+		MutexLocker locker(info->requestLock);
+		if (file->selecting) {
+			info->selectingFiles.Remove(file);
+			file->selecting = false;
+		}
+		if (file->selectPool != NULL) {
+			delete_select_sync_pool(file->selectPool);
+			file->selectPool = NULL;
+		}
+	}
+
+	for (uint32 i = 0; i < file->blobCapacity; i++) {
+		if (file->blobs[i] != NULL)
+			virtio_gpu_destroy_blob(file, file->blobs[i]);
+	}
+	free(file->blobs);
+
+	if (file->contextId != 0) {
+		struct virtio_gpu_ctx_destroy destroy = {};
+		destroy.hdr.type = VIRTIO_GPU_CMD_CTX_DESTROY;
+		destroy.hdr.ctx_id = file->contextId;
+		virtio_gpu_simple_cmd(info, &destroy, sizeof(destroy),
+			"destroy context");
+	}
+
+	mutex_destroy(&file->lock);
+	delete file;
+	return B_OK;
+}
