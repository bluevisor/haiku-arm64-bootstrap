+/*!	Finds the host-visible shared memory region. The virtio bus manager
+	doesn't expose shared memory capabilities, so this reads them from the
+	PCI device the virtio device sits on.
+*/
+static status_t
+virtio_gpu_find_hostmem(virtio_gpu_driver_info* info)
+{
+	pci_device_module_info* pci = NULL;
+	pci_device* device = NULL;
+
+	device_node* node = sDeviceManager->get_parent_node(info->node);
+	while (node != NULL) {
+		const char* bus;
+		if (sDeviceManager->get_attr_string(node, B_DEVICE_BUS, &bus, false)
+				== B_OK && strcmp(bus, "pci") == 0) {
+			sDeviceManager->get_driver(node, (driver_module_info**)&pci,
+				(void**)&device);
+			sDeviceManager->put_node(node);
+			break;
+		}
+		device_node* parent = sDeviceManager->get_parent_node(node);
+		sDeviceManager->put_node(node);
+		node = parent;
+	}
+	if (pci == NULL || device == NULL)
+		return B_ENTRY_NOT_FOUND;
+
+	uint8 capabilityOffset;
+	if (pci->find_pci_capability(device, PCI_cap_id_vendspec,
+			&capabilityOffset) != B_OK) {
+		return B_ENTRY_NOT_FOUND;
+	}
+
+	pci_info pciInfo;
+	pci->get_pci_info(device, &pciInfo);
+
+	while (capabilityOffset != 0) {
+		uint32 header = pci->read_pci_config(device, capabilityOffset, 4);
+		uint8 next = (header >> 8) & 0xff;
+		uint8 length = (header >> 16) & 0xff;
+		uint8 cfgType = header >> 24;
+
+		// struct virtio_pci_cap64
+		if ((header & 0xff) == PCI_cap_id_vendspec
+			&& cfgType == VIRTIO_PCI_CAP_SHARED_MEMORY_CFG && length >= 24) {
+			uint32 barAndId = pci->read_pci_config(device,
+				capabilityOffset + 4, 4);
+			uint8 bar = barAndId & 0xff;
+			uint8 id = (barAndId >> 8) & 0xff;
+			uint64 offset = pci->read_pci_config(device, capabilityOffset + 8, 4)
+				| (uint64)pci->read_pci_config(device, capabilityOffset + 16, 4)
+					<< 32;
+			uint64 size = pci->read_pci_config(device, capabilityOffset + 12, 4)
+				| (uint64)pci->read_pci_config(device, capabilityOffset + 20, 4)
+					<< 32;
+
+			if (id == VIRTIO_GPU_SHM_ID_HOST_VISIBLE && bar < 6) {
+				phys_addr_t barAddress = pciInfo.u.h0.base_registers[bar];
+				if ((pciInfo.u.h0.base_register_flags[bar] & PCI_address_type)
+						== PCI_address_type_64 && bar < 5) {
+					barAddress |= (uint64)pciInfo.u.h0.base_registers[bar + 1]
+						<< 32;
+				}
+				if (barAddress == 0)
+					return B_DEVICE_NOT_FOUND;
+
+				info->hostmemBase = barAddress + offset;
+				info->hostmemSize = size;
+				dprintf(DEVICE_NAME ": host visible region %#" B_PRIxPHYSADDR
+					", %" B_PRIu64 " MiB (BAR %u)\n", info->hostmemBase,
+					size / (1024 * 1024), bar);
+				return B_OK;
+			}
+		}
+		capabilityOffset = next;
+	}
+	return B_ENTRY_NOT_FOUND;
+}
