+#ifndef VIRTIO_GPU_3D_H
+#define VIRTIO_GPU_3D_H
+
+
+#include <Drivers.h>
+
+
+/*
+ * 3D interface of the virtio_gpu driver. Besides the display device under
+ * /dev/graphics, the driver publishes a render node per GPU in
+ * VIRTIO_GPU_RENDER_DEVICE_DIR. It follows the Linux virtgpu DRM uAPI, so
+ * that Mesa's virtgpu backends (Venus) port with few changes: every open
+ * file gets at most one context, buffer handles are per file, and the structs
+ * have the layout of their drm_virtgpu_* counterparts where the semantics
+ * match. The differences:
+ *
+ *  - GETPARAM returns the value in the struct instead of through a pointer.
+ *  - MAP maps the blob into the calling team and returns its address; there
+ *    is no mmap() on the device. UNMAP removes that mapping again.
+ *  - EXECBUFFER returns a fence id instead of a sync_file fd. Another open of
+ *    the render node bound to that id with FENCE_BIND becomes readable
+ *    (select()/poll()) once the fence has signaled, which stands in for the
+ *    sync_file.
+ */
+
+#define VIRTIO_GPU_RENDER_DEVICE_DIR	"/dev/misc/virtio_gpu"
+
+
+enum {
+	VIRTIO_GPU_3D_GETPARAM = B_DEVICE_OP_CODES_END + 0x100,
+	VIRTIO_GPU_3D_GET_CAPS,
+	VIRTIO_GPU_3D_CONTEXT_INIT,
+	VIRTIO_GPU_3D_RESOURCE_CREATE_BLOB,
+	VIRTIO_GPU_3D_RESOURCE_INFO,
+	VIRTIO_GPU_3D_MAP,
+	VIRTIO_GPU_3D_UNMAP,
+	VIRTIO_GPU_3D_CLOSE_HANDLE,
+	VIRTIO_GPU_3D_EXECBUFFER,
+	VIRTIO_GPU_3D_FENCE_BIND,
+	VIRTIO_GPU_3D_FENCE_WAIT,
+};
+
+
+/* GETPARAM, same values as Linux's VIRTGPU_PARAM_* */
+#define VIRTIO_GPU_3D_PARAM_3D_FEATURES				1
+#define VIRTIO_GPU_3D_PARAM_CAPSET_QUERY_FIX		2
+#define VIRTIO_GPU_3D_PARAM_RESOURCE_BLOB			3
+#define VIRTIO_GPU_3D_PARAM_HOST_VISIBLE			4
+#define VIRTIO_GPU_3D_PARAM_CROSS_DEVICE			5
+#define VIRTIO_GPU_3D_PARAM_CONTEXT_INIT			6
+#define VIRTIO_GPU_3D_PARAM_SUPPORTED_CAPSET_IDS	7
+#define VIRTIO_GPU_3D_PARAM_EXPLICIT_DEBUG_NAME		8
+#define VIRTIO_GPU_3D_PARAM_BLOB_ALIGNMENT			9
+
+struct virtio_gpu_3d_getparam {
+	uint64	param;
+	uint64	value;			/* out */
+};
+
+/* GET_CAPS */
+#define VIRTIO_GPU_3D_CAPSET_VIRGL		1
+#define VIRTIO_GPU_3D_CAPSET_VIRGL2		2
+#define VIRTIO_GPU_3D_CAPSET_VENUS		4
+#define VIRTIO_GPU_3D_CAPSET_DRM		6
+
+struct virtio_gpu_3d_get_caps {
+	uint32	cap_set_id;
+	uint32	cap_set_ver;
+	uint64	addr;			/* buffer for the capset data */
+	uint32	size;
+	uint32	pad;
+};
+
+/* CONTEXT_INIT */
+#define VIRTIO_GPU_3D_CONTEXT_PARAM_CAPSET_ID		1
+#define VIRTIO_GPU_3D_CONTEXT_PARAM_NUM_RINGS		2
+#define VIRTIO_GPU_3D_CONTEXT_PARAM_POLL_RINGS_MASK	3
+#define VIRTIO_GPU_3D_CONTEXT_PARAM_DEBUG_NAME		4
+
+struct virtio_gpu_3d_context_set_param {
+	uint64	param;
+	uint64	value;
+};
+
+struct virtio_gpu_3d_context_init {
+	uint32	num_params;
+	uint32	pad;
+	uint64	ctx_set_params;	/* array of virtio_gpu_3d_context_set_param */
+};
+
+/* RESOURCE_CREATE_BLOB */
+#define VIRTIO_GPU_3D_BLOB_MEM_GUEST			0x0001
+#define VIRTIO_GPU_3D_BLOB_MEM_HOST3D			0x0002
+#define VIRTIO_GPU_3D_BLOB_MEM_HOST3D_GUEST		0x0003
+
+#define VIRTIO_GPU_3D_BLOB_FLAG_USE_MAPPABLE	0x0001
+#define VIRTIO_GPU_3D_BLOB_FLAG_USE_SHAREABLE	0x0002
+#define VIRTIO_GPU_3D_BLOB_FLAG_USE_CROSS_DEVICE	0x0004
+
+struct virtio_gpu_3d_resource_create_blob {
+	uint32	blob_mem;
+	uint32	blob_flags;
+	uint32	bo_handle;		/* out */
+	uint32	res_handle;		/* out */
+	uint64	size;			/* a multiple of PARAM_BLOB_ALIGNMENT */
+	uint32	pad;
+	uint32	cmd_size;
+	uint64	cmd;			/* submitted to the context before the create */
+	uint64	blob_id;
+};
+
+/* RESOURCE_INFO */
+struct virtio_gpu_3d_resource_info {
+	uint32	bo_handle;
+	uint32	res_handle;		/* out */
+	uint32	size;			/* out */
+	uint32	blob_mem;		/* out */
+};
+
+/* MAP */
+struct virtio_gpu_3d_map {
+	uint32	handle;
+	int32	area;			/* out */
+	uint64	address;		/* out */
+};
+
+/* UNMAP, CLOSE_HANDLE */
+struct virtio_gpu_3d_handle {
+	uint32	handle;
+	uint32	pad;
+};
+
+/* EXECBUFFER */
+#define VIRTIO_GPU_3D_EXECBUF_FENCE		0x01	/* return a fence id */
+#define VIRTIO_GPU_3D_EXECBUF_RING_IDX	0x02	/* fence on ring_idx's timeline */
+
+struct virtio_gpu_3d_execbuffer {
+	uint32	flags;
+	uint32	size;
+	uint64	command;
+	uint32	ring_idx;
+	uint32	pad;
+	uint64	fence_id;		/* out, 0 without EXECBUF_FENCE */
+};
+
+/* FENCE_BIND, FENCE_WAIT */
+struct virtio_gpu_3d_fence {
+	uint64	fence_id;
+	int64	timeout;		/* FENCE_WAIT only: microseconds, < 0 waits forever */
+};
+
+
+#endif	/* VIRTIO_GPU_3D_H */
