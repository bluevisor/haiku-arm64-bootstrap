+
+static status_t
+virtio_gpu_render_open(void* _info, const char* path, int openMode,
+	void** _cookie)
+{
+	CALLED();
+	virtio_gpu_driver_info* info = (virtio_gpu_driver_info*)_info;
+
+	virtio_gpu_render_file* file = new(std::nothrow) virtio_gpu_render_file;
+	if (file == NULL)
+		return B_NO_MEMORY;
+
+	file->info = info;
+	mutex_init(&file->lock, "virtio_gpu render file");
+	file->contextId = 0;
+	file->capsetId = 0;
+	file->blobs = NULL;
+	file->blobCapacity = 0;
+	file->fenceBound = false;
+	file->fenceId = 0;
+	file->selectPool = NULL;
+	file->selecting = false;
+
+	*_cookie = file;
+	return B_OK;
+}
