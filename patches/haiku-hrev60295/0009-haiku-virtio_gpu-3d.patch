+static status_t
+virtio_gpu_add_blob(virtio_gpu_render_file* file, virtio_gpu_blob* blob,
+	uint32* _handle)
+{
+	for (uint32 i = 0; i < file->blobCapacity; i++) {
+		if (file->blobs[i] == NULL) {
+			file->blobs[i] = blob;
+			*_handle = i + 1;
+			return B_OK;
+		}
+	}
+
+	uint32 capacity = file->blobCapacity == 0 ? 64 : file->blobCapacity * 2;
+	virtio_gpu_blob** blobs = (virtio_gpu_blob**)realloc(file->blobs,
+		capacity * sizeof(virtio_gpu_blob*));
+	if (blobs == NULL)
+		return B_NO_MEMORY;
+	memset(blobs + file->blobCapacity, 0,
+		(capacity - file->blobCapacity) * sizeof(virtio_gpu_blob*));
+
+	blobs[file->blobCapacity] = blob;
+	*_handle = file->blobCapacity + 1;
+	file->blobs = blobs;
+	file->blobCapacity = capacity;
+	return B_OK;
+}
