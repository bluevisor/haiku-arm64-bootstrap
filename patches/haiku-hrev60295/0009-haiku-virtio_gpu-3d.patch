+static status_t
+virtio_gpu_hostmem_alloc(virtio_gpu_driver_info* info, uint64 size,
+	uint64* _offset)
+{
+	MutexLocker locker(info->hostmemLock);
+
+	// first fit; the list is sorted by offset
+	uint64 offset = 0;
+	HostmemRangeList::Iterator iterator = info->hostmemRanges.GetIterator();
+	virtio_gpu_hostmem_range* next = NULL;
+	while ((next = iterator.Next()) != NULL) {
+		if (next->offset - offset >= size)
+			break;
+		offset = next->offset + next->size;
+	}
+	if (offset + size > info->hostmemSize)
+		return B_NO_MEMORY;
+
+	virtio_gpu_hostmem_range* range
+		= new(std::nothrow) virtio_gpu_hostmem_range;
+	if (range == NULL)
+		return B_NO_MEMORY;
+	range->offset = offset;
+	range->size = size;
+
+	if (next != NULL)
+		info->hostmemRanges.InsertBefore(next, range);
+	else
+		info->hostmemRanges.Add(range);
+
+	*_offset = offset;
+	return B_OK;
+}
+
+
+static void
+virtio_gpu_hostmem_free(virtio_gpu_driver_info* info, uint64 offset)
+{
+	MutexLocker locker(info->hostmemLock);
+
+	HostmemRangeList::Iterator iterator = info->hostmemRanges.GetIterator();
+	while (virtio_gpu_hostmem_range* range = iterator.Next()) {
+		if (range->offset == offset) {
+			iterator.Remove();
+			delete range;
+			return;
+		}
+	}
+}
