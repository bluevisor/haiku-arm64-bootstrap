+
+template<typename Args>
+static status_t
+virtio_gpu_copy_args(Args& args, void* buffer, size_t length)
+{
+	if (length != sizeof(Args) || !IS_USER_ADDRESS(buffer))
+		return B_BAD_VALUE;
+	return user_memcpy(&args, buffer, sizeof(Args));
+}
+
+
+static status_t
+virtio_gpu_render_ioctl(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	virtio_gpu_render_file* file = (virtio_gpu_render_file*)cookie;
+	virtio_gpu_driver_info* info = file->info;
+	status_t status;
+
+	switch (op) {
+		case VIRTIO_GPU_3D_GETPARAM:
+		{
+			virtio_gpu_3d_getparam args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			if ((status = virtio_gpu_render_getparam(file, args)) != B_OK)
+				return status;
+			return user_memcpy(buffer, &args, sizeof(args));
+		}
+
+		case VIRTIO_GPU_3D_GET_CAPS:
+		{
+			virtio_gpu_3d_get_caps args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			return virtio_gpu_render_get_caps(file, args);
+		}
+
+		case VIRTIO_GPU_3D_CONTEXT_INIT:
+		{
+			virtio_gpu_3d_context_init args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			return virtio_gpu_render_context_init(file, args);
+		}
+
+		case VIRTIO_GPU_3D_RESOURCE_CREATE_BLOB:
+		{
+			virtio_gpu_3d_resource_create_blob args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			if ((status = virtio_gpu_render_create_blob(file, args)) != B_OK)
+				return status;
+			return user_memcpy(buffer, &args, sizeof(args));
+		}
+
+		case VIRTIO_GPU_3D_RESOURCE_INFO:
+		{
+			virtio_gpu_3d_resource_info args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+
+			MutexLocker locker(file->lock);
+			virtio_gpu_blob* blob = virtio_gpu_lookup_blob(file, args.bo_handle);
+			if (blob == NULL)
+				return B_BAD_VALUE;
+			args.res_handle = blob->resourceId;
+			args.size = blob->size;
+			args.blob_mem = blob->blobMem;
+			locker.Unlock();
+			return user_memcpy(buffer, &args, sizeof(args));
+		}
+
+		case VIRTIO_GPU_3D_MAP:
+		{
+			virtio_gpu_3d_map args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			if ((status = virtio_gpu_render_map(file, args)) != B_OK)
+				return status;
+			return user_memcpy(buffer, &args, sizeof(args));
+		}
+
+		case VIRTIO_GPU_3D_UNMAP:
+		case VIRTIO_GPU_3D_CLOSE_HANDLE:
+		{
+			virtio_gpu_3d_handle args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+
+			MutexLocker locker(file->lock);
+			virtio_gpu_blob* blob = virtio_gpu_lookup_blob(file, args.handle);
+			if (blob == NULL)
+				return B_BAD_VALUE;
+			if (op == VIRTIO_GPU_3D_UNMAP) {
+				virtio_gpu_unmap_blob_area(blob);
+				return B_OK;
+			}
+			file->blobs[args.handle - 1] = NULL;
+			virtio_gpu_destroy_blob(file, blob);
+			return B_OK;
+		}
+
+		case VIRTIO_GPU_3D_EXECBUFFER:
+		{
+			virtio_gpu_3d_execbuffer args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			if ((status = virtio_gpu_render_execbuffer(file, args)) != B_OK)
+				return status;
+			return user_memcpy(buffer, &args, sizeof(args));
+		}
+
+		case VIRTIO_GPU_3D_FENCE_BIND:
+		{
+			virtio_gpu_3d_fence args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+
+			MutexLocker locker(info->requestLock);
+			file->fenceBound = true;
+			file->fenceId = args.fence_id;
+			if (file->selectPool != NULL
+				&& virtio_gpu_fence_signaled_locked(info, file->fenceId)) {
+				notify_select_event_pool(file->selectPool, B_SELECT_READ);
+			}
+			return B_OK;
+		}
+
+		case VIRTIO_GPU_3D_FENCE_WAIT:
+		{
+			virtio_gpu_3d_fence args;
+			if ((status = virtio_gpu_copy_args(args, buffer, length)) != B_OK)
+				return status;
+			return virtio_gpu_render_fence_wait(file, args);
+		}
+	}
+
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+static status_t
+virtio_gpu_render_select(void* cookie, uint8 event, selectsync* sync)
+{
+	virtio_gpu_render_file* file = (virtio_gpu_render_file*)cookie;
+	virtio_gpu_driver_info* info = file->info;
+
+	if (event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	MutexLocker locker(info->requestLock);
+	status_t status = add_select_sync_pool_entry(&file->selectPool, sync,
+		event);
+	if (status != B_OK)
+		return status;
+
+	if (!file->selecting) {
+		info->selectingFiles.Add(file);
+		file->selecting = true;
+	}
+	if (file->fenceBound
+		&& virtio_gpu_fence_signaled_locked(info, file->fenceId)) {
+		notify_select_event(sync, event);
+	}
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_deselect(void* cookie, uint8 event, selectsync* sync)
+{
+	virtio_gpu_render_file* file = (virtio_gpu_render_file*)cookie;
+	virtio_gpu_driver_info* info = file->info;
+
+	MutexLocker locker(info->requestLock);
+	remove_select_sync_pool_entry(&file->selectPool, sync, event);
+	if (file->selectPool == NULL && file->selecting) {
+		info->selectingFiles.Remove(file);
+		file->selecting = false;
+	}
+	return B_OK;
+}
