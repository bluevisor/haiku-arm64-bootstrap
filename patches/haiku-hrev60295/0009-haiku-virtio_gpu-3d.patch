+
+/*!	Puts \a request on the control queue, waiting for room if it is full.
+	A fenced request gets the next fence id here, so that fence ids are
+	increasing in queue order, as the host expects.
+	Must be called with the requestLock held.
+*/
+static status_t
+virtio_gpu_queue_request_locked(virtio_gpu_driver_info* info,
+	virtio_gpu_request* request, bigtime_t deadline)
+{
+	uint32 maxEntries = (request->commandSize + request->responseSize)
+		/ B_PAGE_SIZE + 4;
+	physical_entry* entries = (physical_entry*)malloc(
+		sizeof(physical_entry) * maxEntries);
+	if (entries == NULL)
+		return B_NO_MEMORY;
+
+	uint32 commandCount = maxEntries;
+	status_t status = get_memory_map_etc(B_SYSTEM_TEAM, request->buffer,
+		request->commandSize, entries, &commandCount);
+	uint32 responseCount = maxEntries - commandCount;
+	if (status == B_OK) {
+		status = get_memory_map_etc(B_SYSTEM_TEAM,
+			request->buffer + request->commandSize, request->responseSize,
+			entries + commandCount, &responseCount);
+	}
+	if (status != B_OK) {
+		free(entries);
+		return status;
+	}
+
+	virtio_gpu_ctrl_hdr* header = virtio_gpu_request_header(request);
+	bool fenced = (header->flags & VIRTIO_GPU_FLAG_FENCE) != 0;
+	if (request->fenceId != 0)
+		info->pendingFences.Add(request);
+
+	while (true) {
+		// Waiting for room drops the lock, so the id is taken right before
+		// each attempt to keep ids increasing in queue order.
+		if (fenced) {
+			header->fence_id = ++info->lastFenceId;
+			if (request->fenceId != 0)
+				request->fenceId = header->fence_id;
+		}
+
+		status = info->virtio->queue_request_v(info->controlQueue, entries,
+			commandCount, responseCount, request);
+		if (status != B_BUSY)
+			break;
+
+		// The queue is full; completions make room.
+		status = info->requestCondition.Wait(&info->requestLock,
+			B_ABSOLUTE_TIMEOUT, deadline);
+		if (status == B_TIMED_OUT) {
+			// not queued, so unlike a response timeout the caller keeps it
+			status = B_BUSY;
+			break;
+		}
+	}
+	free(entries);
+
+	if (status != B_OK && request->fenceId != 0)
+		info->pendingFences.Remove(request);
+	return status;
+}
+
+
+/*!	Sends \a request and waits for its response. If that times out, the
+	request is left to the completion thread and B_TIMED_OUT is returned;
+	the caller must not touch it anymore. In all other cases the caller
+	owns the request.
+*/
+static status_t
+virtio_gpu_send_request(virtio_gpu_driver_info* info,
+	virtio_gpu_request* request)
+{
+	bigtime_t deadline = system_time() + VIRTIO_GPU_COMMAND_TIMEOUT;
 
-	status_t status = info->virtio->queue_request_v(info->controlQueue, entries, 1, 1, NULL);
+	MutexLocker locker(info->requestLock);
+	status_t status = virtio_gpu_queue_request_locked(info, request, deadline);
 	if (status != B_OK)
 		return status;
 
-	acquire_sem(info->commandDone);
+	while (!request->done) {
+		status = info->requestCondition.Wait(&info->requestLock,
+			B_ABSOLUTE_TIMEOUT, deadline);
+		if (status == B_TIMED_OUT && !request->done) {
+			ERROR("command %#" B_PRIx32 " timed out\n",
+				virtio_gpu_request_header(request)->type);
+			request->async = true;
+			return B_TIMED_OUT;
+		}
+	}
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_send_cmd(virtio_gpu_driver_info* info, const void* cmd,
+	size_t cmdSize, void* response, size_t responseSize, bool fenced = true)
+{
+	virtio_gpu_request* request = virtio_gpu_request_create(cmdSize,
+		responseSize);
+	if (request == NULL)
+		return B_NO_MEMORY;
+
+	memcpy(request->buffer, cmd, cmdSize);
+	if (fenced)
+		virtio_gpu_request_header(request)->flags |= VIRTIO_GPU_FLAG_FENCE;
+
+	status_t status = virtio_gpu_send_request(info, request);
+	if (status == B_TIMED_OUT)
+		return status;
+
+	if (status == B_OK)
+		memcpy(response, virtio_gpu_request_response(request), responseSize);
+	virtio_gpu_request_delete(request);
+	return status;
+}
+
+
+static bool
+virtio_gpu_fence_signaled_locked(virtio_gpu_driver_info* info, uint64 fenceId)
+{
+	if (fenceId == 0 || fenceId > info->lastFenceId)
+		return true;
+
+	RequestList::Iterator iterator = info->pendingFences.GetIterator();
+	while (virtio_gpu_request* request = iterator.Next()) {
+		if (request->fenceId == fenceId)
+			return false;
+	}
+	return true;
+}
+
+
+static void
+virtio_gpu_notify_fence_selects_locked(virtio_gpu_driver_info* info)
+{
+	RenderFileList::Iterator iterator = info->selectingFiles.GetIterator();
+	while (virtio_gpu_render_file* file = iterator.Next()) {
+		if (file->fenceBound
+			&& virtio_gpu_fence_signaled_locked(info, file->fenceId)) {
+			notify_select_event_pool(file->selectPool, B_SELECT_READ);
+		}
+	}
+}
 
