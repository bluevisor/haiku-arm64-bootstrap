+static status_t
+virtio_gpu_render_getparam(virtio_gpu_render_file* file,
+	virtio_gpu_3d_getparam& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	switch (args.param) {
+		case VIRTIO_GPU_3D_PARAM_3D_FEATURES:
+			args.value = (info->features & VIRTIO_GPU_F_VIRGL) != 0;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_CAPSET_QUERY_FIX:
+		case VIRTIO_GPU_3D_PARAM_EXPLICIT_DEBUG_NAME:
+			args.value = 1;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_RESOURCE_BLOB:
+			args.value = (info->features & VIRTIO_GPU_F_RESOURCE_BLOB) != 0;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_HOST_VISIBLE:
+			args.value = info->hostmemSize != 0;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_CROSS_DEVICE:
+			args.value = 0;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_CONTEXT_INIT:
+			args.value = (info->features & VIRTIO_GPU_F_CONTEXT_INIT) != 0;
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_SUPPORTED_CAPSET_IDS:
+			args.value = 0;
+			for (uint32 i = 0; i < info->capsetCount; i++) {
+				if (info->capsets[i].id < 64)
+					args.value |= 1ULL << info->capsets[i].id;
+			}
+			return B_OK;
+		case VIRTIO_GPU_3D_PARAM_BLOB_ALIGNMENT:
+			args.value = VIRTIO_GPU_BLOB_ALIGNMENT;
+			return B_OK;
+	}
+	return B_BAD_VALUE;
+}
+
+
+static status_t
+virtio_gpu_render_get_caps(virtio_gpu_render_file* file,
+	const virtio_gpu_3d_get_caps& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	virtio_gpu_capset* capset = virtio_gpu_find_capset(info, args.cap_set_id);
+	if (capset == NULL || args.cap_set_ver > capset->maxVersion)
+		return B_BAD_VALUE;
+	if (!IS_USER_ADDRESS((void*)(addr_t)args.addr))
+		return B_BAD_ADDRESS;
+
+	virtio_gpu_request* request = virtio_gpu_request_create(
+		sizeof(virtio_gpu_get_capset),
+		sizeof(virtio_gpu_resp_capset) + capset->maxSize);
+	if (request == NULL)
+		return B_NO_MEMORY;
+
+	virtio_gpu_get_capset* get = (virtio_gpu_get_capset*)request->buffer;
+	get->hdr.type = VIRTIO_GPU_CMD_GET_CAPSET;
+	get->capset_id = capset->id;
+	get->capset_version = args.cap_set_ver;
+
+	status_t status = virtio_gpu_send_request(info, request);
+	if (status == B_TIMED_OUT)
+		return status;
+
+	virtio_gpu_resp_capset* response
+		= (virtio_gpu_resp_capset*)virtio_gpu_request_response(request);
+	if (status == B_OK) {
+		status = virtio_gpu_check_response(response->hdr,
+			VIRTIO_GPU_RESP_OK_CAPSET, "get capset");
+	}
+	if (status == B_OK) {
+		status = user_memcpy((void*)(addr_t)args.addr, response->capset_data,
+			min_c(args.size, capset->maxSize));
+	}
+	virtio_gpu_request_delete(request);
+	return status;
+}
+
+
+static status_t
+virtio_gpu_render_context_init(virtio_gpu_render_file* file,
+	const virtio_gpu_3d_context_init& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	virtio_gpu_3d_context_set_param params[8];
+	if (args.num_params > B_COUNT_OF(params))
+		return B_BAD_VALUE;
+	if (!IS_USER_ADDRESS((void*)(addr_t)args.ctx_set_params)
+		|| user_memcpy(params, (void*)(addr_t)args.ctx_set_params,
+			args.num_params * sizeof(params[0])) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	uint32 capsetId = 0;
+	char name[64] = {};
+	for (uint32 i = 0; i < args.num_params; i++) {
+		switch (params[i].param) {
+			case VIRTIO_GPU_3D_CONTEXT_PARAM_CAPSET_ID:
+				capsetId = params[i].value;
+				break;
+			case VIRTIO_GPU_3D_CONTEXT_PARAM_NUM_RINGS:
+				if (params[i].value > VIRTIO_GPU_MAX_RINGS)
+					return B_BAD_VALUE;
+				break;
+			case VIRTIO_GPU_3D_CONTEXT_PARAM_POLL_RINGS_MASK:
+				// fences are always waited for through the driver
+				break;
+			case VIRTIO_GPU_3D_CONTEXT_PARAM_DEBUG_NAME:
+				if (!IS_USER_ADDRESS((void*)(addr_t)params[i].value)
+					|| user_strlcpy(name, (const char*)(addr_t)params[i].value,
+						sizeof(name)) < B_OK) {
+					return B_BAD_ADDRESS;
+				}
+				break;
+			default:
+				return B_BAD_VALUE;
+		}
+	}
+
+	if (capsetId != 0 && (virtio_gpu_find_capset(info, capsetId) == NULL
+			|| (info->features & VIRTIO_GPU_F_CONTEXT_INIT) == 0)) {
+		return B_BAD_VALUE;
+	}
+	if (name[0] == '\0') {
+		snprintf(name, sizeof(name), "team %" B_PRId32,
+			team_get_current_team_id());
+	}
+
+	MutexLocker locker(file->lock);
+	if (file->contextId != 0)
+		return B_BUSY;
+
+	uint32 contextId = atomic_add(&info->nextContextId, 1);
+
+	struct virtio_gpu_ctx_create create = {};
+	create.hdr.type = VIRTIO_GPU_CMD_CTX_CREATE;
+	create.hdr.ctx_id = contextId;
+	create.context_init = capsetId & VIRTIO_GPU_CONTEXT_INIT_CAPSET_ID_MASK;
+	create.nlen = strnlen(name, sizeof(create.debug_name));
+	memcpy(create.debug_name, name, create.nlen);
+
+	status_t status = virtio_gpu_simple_cmd(info, &create, sizeof(create),
+		"create context");
+	if (status != B_OK)
+		return status;
+
+	file->contextId = contextId;
+	file->capsetId = capsetId;
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_create_blob(virtio_gpu_render_file* file,
+	virtio_gpu_3d_resource_create_blob& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	if ((info->features & VIRTIO_GPU_F_RESOURCE_BLOB) == 0)
+		return B_NOT_SUPPORTED;
+	// Only host memory for now: Venus allocates everything that way.
+	if (args.blob_mem != VIRTIO_GPU_BLOB_MEM_HOST3D)
+		return B_NOT_SUPPORTED;
+	if (args.size == 0 || args.size % VIRTIO_GPU_BLOB_ALIGNMENT != 0)
+		return B_BAD_VALUE;
+	if ((args.blob_flags & ~(VIRTIO_GPU_BLOB_FLAG_USE_MAPPABLE
+			| VIRTIO_GPU_BLOB_FLAG_USE_SHAREABLE)) != 0) {
+		return B_BAD_VALUE;
+	}
+
+	MutexLocker locker(file->lock);
+	if (file->contextId == 0)
+		return B_BAD_VALUE;
+
+	status_t status;
+	if (args.cmd_size > 0) {
+		// The command creates the host memory that blob_id refers to.
+		virtio_gpu_request* request;
+		status = virtio_gpu_create_submit(file->contextId, args.cmd,
+			args.cmd_size, &request);
+		if (status != B_OK)
+			return status;
+
+		status = virtio_gpu_send_request(info, request);
+		if (status == B_TIMED_OUT)
+			return status;
+		if (status == B_OK) {
+			status = virtio_gpu_check_response(
+				*virtio_gpu_request_response(request),
+				VIRTIO_GPU_RESP_OK_NODATA, "blob command");
+		}
+		virtio_gpu_request_delete(request);
+		if (status != B_OK)
+			return status;
+	}
+
+	virtio_gpu_blob* blob = new(std::nothrow) virtio_gpu_blob;
+	if (blob == NULL)
+		return B_NO_MEMORY;
+	blob->resourceId = atomic_add(&info->nextResourceId, 1);
+	blob->blobMem = args.blob_mem;
+	blob->blobFlags = args.blob_flags;
+	blob->size = args.size;
+	blob->hostMapped = false;
+	blob->hostOffset = 0;
+	blob->mapInfo = 0;
+	blob->area = -1;
+	blob->team = -1;
+	blob->address = NULL;
+
+	struct virtio_gpu_resource_create_blob create = {};
+	create.hdr.type = VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB;
+	create.hdr.ctx_id = file->contextId;
+	create.resource_id = blob->resourceId;
+	create.blob_mem = args.blob_mem;
+	create.blob_flags = args.blob_flags;
+	create.blob_id = args.blob_id;
+	create.size = args.size;
+	status = virtio_gpu_simple_cmd(info, &create, sizeof(create), "create blob");
+	if (status != B_OK) {
+		delete blob;
+		return status;
+	}
+
+	struct virtio_gpu_ctx_resource attach = {};
+	attach.hdr.type = VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE;
+	attach.hdr.ctx_id = file->contextId;
+	attach.resource_id = blob->resourceId;
+	status = virtio_gpu_simple_cmd(info, &attach, sizeof(attach),
+		"attach resource");
+
+	uint32 handle = 0;
+	if (status == B_OK)
+		status = virtio_gpu_add_blob(file, blob, &handle);
+	if (status != B_OK) {
+		struct virtio_gpu_resource_unref unref = {};
+		unref.hdr.type = VIRTIO_GPU_CMD_RESOURCE_UNREF;
+		unref.resource_id = blob->resourceId;
+		virtio_gpu_simple_cmd(info, &unref, sizeof(unref), "unref resource");
+		delete blob;
+		return status;
+	}
+
+	args.bo_handle = handle;
+	args.res_handle = blob->resourceId;
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_map(virtio_gpu_render_file* file, virtio_gpu_3d_map& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	MutexLocker locker(file->lock);
+	virtio_gpu_blob* blob = virtio_gpu_lookup_blob(file, args.handle);
+	if (blob == NULL)
+		return B_BAD_VALUE;
+	if ((blob->blobFlags & VIRTIO_GPU_BLOB_FLAG_USE_MAPPABLE) == 0
+		|| info->hostmemSize == 0) {
+		return B_NOT_ALLOWED;
+	}
+
+	team_id team = team_get_current_team_id();
+	if (blob->area >= 0) {
+		if (blob->team != team)
+			return B_BUSY;
+		args.area = blob->area;
+		args.address = (addr_t)blob->address;
+		return B_OK;
+	}
+
+	if (!blob->hostMapped) {
+		uint64 offset;
+		status_t status = virtio_gpu_hostmem_alloc(info, blob->size, &offset);
+		if (status != B_OK)
+			return status;
+
+		struct virtio_gpu_resource_map_blob map = {};
+		struct virtio_gpu_resp_map_info response = {};
+		map.hdr.type = VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB;
+		map.hdr.ctx_id = file->contextId;
+		map.resource_id = blob->resourceId;
+		map.offset = offset;
+		status = virtio_gpu_send_cmd(info, &map, sizeof(map), &response,
+			sizeof(response), false);
+		if (status == B_OK) {
+			status = virtio_gpu_check_response(response.hdr,
+				VIRTIO_GPU_RESP_OK_MAP_INFO, "map blob");
+		}
+		if (status != B_OK) {
+			if (status != B_TIMED_OUT)
+				virtio_gpu_hostmem_free(info, offset);
+			return status;
+		}
+
+		blob->hostMapped = true;
+		blob->hostOffset = offset;
+		blob->mapInfo = response.map_info;
+	}
+
+	// Device memory (the uncached default) would fault on unaligned
+	// accesses, which memcpy() does all the time; write combining is the
+	// closest normal memory type.
+	uint32 memoryType = B_WRITE_BACK_MEMORY;
+	switch (blob->mapInfo & VIRTIO_GPU_MAP_CACHE_MASK) {
+		case VIRTIO_GPU_MAP_CACHE_UNCACHED:
+		case VIRTIO_GPU_MAP_CACHE_WC:
+			memoryType = B_WRITE_COMBINING_MEMORY;
+			break;
+	}
+
+	// B_SHARED_AREA: fork() copies every other area copy-on-write, which
+	// would detach the parent from the host memory (the Venus ring stalls)
+	// and leave device pages in a private cache (the kernel hangs on exit).
+	void* address = NULL;
+	area_id area = vm_map_physical_memory(team, "virtio_gpu blob", &address,
+		B_ANY_ADDRESS | memoryType, blob->size,
+		B_READ_AREA | B_WRITE_AREA | B_SHARED_AREA,
+		info->hostmemBase + blob->hostOffset, false);
+	if (area < 0)
+		return area;
+
+	blob->area = area;
+	blob->team = team;
+	blob->address = address;
+
+	args.area = area;
+	args.address = (addr_t)address;
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_execbuffer(virtio_gpu_render_file* file,
+	virtio_gpu_3d_execbuffer& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	if ((args.flags & ~(VIRTIO_GPU_3D_EXECBUF_FENCE
+			| VIRTIO_GPU_3D_EXECBUF_RING_IDX)) != 0) {
+		return B_BAD_VALUE;
+	}
+	if ((args.flags & VIRTIO_GPU_3D_EXECBUF_RING_IDX) != 0
+		&& args.ring_idx >= VIRTIO_GPU_MAX_RINGS) {
+		return B_BAD_VALUE;
+	}
+
+	uint32 contextId;
+	{
+		MutexLocker locker(file->lock);
+		contextId = file->contextId;
+	}
+	if (contextId == 0)
+		return B_BAD_VALUE;
+
+	virtio_gpu_request* request;
+	status_t status = virtio_gpu_create_submit(contextId, args.command,
+		args.size, &request);
+	if (status != B_OK)
+		return status;
+
+	virtio_gpu_ctrl_hdr* header = virtio_gpu_request_header(request);
+	if ((args.flags & VIRTIO_GPU_3D_EXECBUF_FENCE) != 0) {
+		header->flags = VIRTIO_GPU_FLAG_FENCE;
+		if ((args.flags & VIRTIO_GPU_3D_EXECBUF_RING_IDX) != 0) {
+			header->flags |= VIRTIO_GPU_FLAG_INFO_RING_IDX;
+			header->ring_idx = args.ring_idx;
+		}
+		// marks it as tracked; the queue assigns the real id
+		request->fenceId = 1;
+	}
+	request->async = true;
+
+	MutexLocker locker(info->requestLock);
+	status = virtio_gpu_queue_request_locked(info, request,
+		system_time() + VIRTIO_GPU_COMMAND_TIMEOUT);
+	if (status != B_OK) {
+		virtio_gpu_request_delete(request);
+		return status;
+	}
+
+	// The completion thread may free the request once the lock is released.
+	args.fence_id = request->fenceId;
+	return B_OK;
+}
+
+
+static status_t
+virtio_gpu_render_fence_wait(virtio_gpu_render_file* file,
+	const virtio_gpu_3d_fence& args)
+{
+	virtio_gpu_driver_info* info = file->info;
+
+	uint32 flags = B_CAN_INTERRUPT;
+	bigtime_t deadline = 0;
+	if (args.timeout >= 0) {
+		flags |= B_ABSOLUTE_TIMEOUT;
+		deadline = system_time() + args.timeout;
+	}
+
+	MutexLocker locker(info->requestLock);
+	while (!virtio_gpu_fence_signaled_locked(info, args.fence_id)) {
+		if (args.timeout == 0)
+			return B_TIMED_OUT;
+		status_t status = info->requestCondition.Wait(&info->requestLock,
+			flags, deadline);
+		if (status == B_TIMED_OUT || status == B_INTERRUPTED) {
+			if (virtio_gpu_fence_signaled_locked(info, args.fence_id))
+				break;
+			return status;
+		}
+	}
+	return B_OK;
+}
