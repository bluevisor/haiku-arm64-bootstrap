+static status_t
+virtio_gpu_render_init_device(void* _info, void** _cookie)
+{
+	CALLED();
+	virtio_gpu_driver_info* info = (virtio_gpu_driver_info*)_info;
+
+	status_t status = virtio_gpu_init_hw(info);
+	if (status != B_OK)
+		return status;
+
+	*_cookie = info;
+	return B_OK;
+}
