+
+status_t
+ArchitectureArm64::GetInstructionInfo(target_addr_t address,
+	InstructionInfo& _info, CpuState* state)
+{
+	uint8 buffer[4];
+	ssize_t bytesRead = fTeamMemory->ReadMemory(address, buffer,
+		sizeof(buffer));
+	if (bytesRead < 0)
+		return bytesRead;
+	if (bytesRead != (ssize_t)sizeof(buffer))
+		return B_BAD_ADDRESS;
+
+	DisassemblerArm64 disassembler;
+	status_t error = disassembler.Init(address, buffer, bytesRead);
+	if (error != B_OK)
+		return error;
+
+	return disassembler.GetNextInstructionInfo(_info, state);
+}
+
+
+/*!	Follows a PLT stub to the function it jumps to. The stubs GNU ld
+	writes for AArch64 are:
+		adrp	x16, <GOT page>
+		ldr		x17, [x16, #<slot offset>]
+		add		x16, x16, #<slot offset>
+		br		x17
+*/
+status_t
+ArchitectureArm64::ResolvePICFunctionAddress(target_addr_t instructionAddress,
+	CpuState* state, target_addr_t& _targetAddress)
+{
+	// instructionAddress is the PLT stub the call went to
+	target_addr_t stub = instructionAddress;
+	uint32 code[2];
+	if (fTeamMemory->ReadMemory(stub, code, sizeof(code)) != sizeof(code))
+		return B_BAD_VALUE;
+
+	// adrp x16, imm
+	if ((code[0] & 0x9f00001f) != 0x90000010)
+		return B_BAD_VALUE;
+	uint64 immediate = ((code[0] >> 29) & 0x3) | (((code[0] >> 5) & 0x7ffff) << 2);
+	int64 pageOffset = (int64)(immediate << 43) >> 31;
+		// sign extend the 21 bit page number and multiply by 4096
+	target_addr_t page = (stub & ~(target_addr_t)0xfff) + pageOffset;
+
+	// ldr x17, [x16, #imm12 * 8]
+	if ((code[1] & 0xffc003ff) != 0xf9400211)
+		return B_BAD_VALUE;
+	target_addr_t slot = page + ((code[1] >> 10) & 0xfff) * 8;
+
+	target_addr_t target;
+	if (fTeamMemory->ReadMemory(slot, &target, sizeof(target))
+			!= sizeof(target)) {
+		return B_BAD_VALUE;
+	}
+
+	_targetAddress = target;
+	return B_OK;
+}
+
+
+status_t
+ArchitectureArm64::GetWatchpointDebugCapabilities(int32& _maxRegisterCount,
+	int32& _maxBytesPerRegister, uint8& _watchpointCapabilityFlags)
+{
+	// the kernel does not program the hardware watchpoints (yet)
+	_maxRegisterCount = 0;
+	_maxBytesPerRegister = 0;
+	_watchpointCapabilityFlags = 0;
+	return B_OK;
+}
+
+
+status_t
+ArchitectureArm64::GetReturnAddressLocation(StackFrame* frame,
+	target_size_t valueSize, ValueLocation*& _location)
+{
+	// AAPCS64: values up to 16 bytes come back in x0 (and x1); larger ones
+	// are written to memory at x8, which is not preserved past the return.
+	if (valueSize > 16)
+		return B_UNSUPPORTED;
+
+	ValueLocation* location = new(std::nothrow) ValueLocation(IsBigEndian());
+	if (location == NULL)
+		return B_NO_MEMORY;
+	BReference<ValueLocation> locationReference(location, true);
+
+	ValuePieceLocation piece;
+	piece.SetSize(valueSize > 8 ? 8 : valueSize);
+	piece.SetToRegister(ARM64_REGISTER_X0);
+	if (!location->AddPiece(piece))
+		return B_NO_MEMORY;
+
+	if (valueSize > 8) {
+		ValuePieceLocation highPiece;
+		highPiece.SetSize(valueSize - 8);
+		highPiece.SetToRegister(ARM64_REGISTER_X0 + 1);
+		if (!location->AddPiece(highPiece))
+			return B_NO_MEMORY;
+	}
+
+	_location = locationReference.Detach();
+	return B_OK;
+}
+
+
+void
+ArchitectureArm64::_AddRegister(int32 index, const char* name,
+	uint32 bitSize, uint32 valueType, register_type type, bool calleePreserved)
+{
+	if (!fRegisters.Add(Register(index, name, bitSize, valueType, type,
+			calleePreserved))) {
+		throw std::bad_alloc();
+	}
+}
+
+
+void
+ArchitectureArm64::_AddIntegerRegister(int32 index, const char* name,
+	uint32 valueType, register_type type, bool calleePreserved)
+{
+	_AddRegister(index, name, 8 * BVariant::SizeOfType(valueType), valueType,
+		type, calleePreserved);
+}
+
+
+void
+ArchitectureArm64::_AddSIMDRegister(int32 index, const char* name,
+	bool calleePreserved)
+{
+	_AddRegister(index, name, 128, B_RAW_TYPE, REGISTER_TYPE_GENERAL_PURPOSE,
+		calleePreserved);
+}
+
+
+bool
+ArchitectureArm64::_HasFunctionPrologue(FunctionDebugInfo* function) const
+{
+	if (function == NULL || function->Size() < kFunctionPrologueSize)
+		return false;
+
+	uint32 code[2];
+	if (fTeamMemory->ReadMemory(function->Address(), code, sizeof(code))
+			!= sizeof(code)) {
+		return false;
+	}
+
+	// stp x29, x30, [sp, #-N]!  then  mov x29, sp
+	return (code[0] & 0xffc07fff) == 0xa9807bfd && code[1] == 0x910003fd;
+}
