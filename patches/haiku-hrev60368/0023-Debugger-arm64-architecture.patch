+// DWARF register numbers for AArch64 (the "DWARF for the Arm 64-bit
+// Architecture" ABI): x0-x30 are 0-30, sp is 31, pc 32, v0-v31 64-95.
+static const int32 kDwarfPC = 32;
+static const int32 kDwarfV0 = 64;
+static const int32 kFromDwarfRegisterCount = kDwarfV0 + 32;
+
+// The standard frame record: "stp x29, x30, [sp, #-N]!; mov x29, sp".
+static const uint32 kFunctionPrologueSize = 8;
+
+
+// #pragma mark - FromDwarfRegisterMap
+
+
+struct ArchitectureArm64::FromDwarfRegisterMap : RegisterMap {
+	FromDwarfRegisterMap()
+	{
+		for (int32 i = 0; i < kFromDwarfRegisterCount; i++)
+			fIndices[i] = -1;
+		for (int32 i = 0; i <= 30; i++)
+			fIndices[i] = ARM64_REGISTER_X0 + i;
+		fIndices[31] = ARM64_REGISTER_SP;
+		fIndices[kDwarfPC] = ARM64_REGISTER_PC;
+		for (int32 i = 0; i < 32; i++)
+			fIndices[kDwarfV0 + i] = ARM64_REGISTER_V0 + i;
+	}
+
+	virtual int32 CountRegisters() const
+	{
+		return kFromDwarfRegisterCount;
+	}
+
+	virtual int32 MapRegisterIndex(int32 index) const
+	{
+		return index >= 0 && index < kFromDwarfRegisterCount
+			? fIndices[index] : -1;
+	}
+
+private:
+	int32	fIndices[kFromDwarfRegisterCount];
+};
+
+
+// #pragma mark - ToDwarfRegisterMap
+
+
+struct ArchitectureArm64::ToDwarfRegisterMap : RegisterMap {
+	ToDwarfRegisterMap(const FromDwarfRegisterMap& fromDwarf)
+	{
+		for (int32 i = 0; i < ARM64_REGISTER_COUNT; i++)
+			fIndices[i] = -1;
+		for (int32 i = 0; i < kFromDwarfRegisterCount; i++) {
+			int32 index = fromDwarf.MapRegisterIndex(i);
+			if (index >= 0)
+				fIndices[index] = i;
+		}
+	}
+
+	virtual int32 CountRegisters() const
+	{
+		return ARM64_REGISTER_COUNT;
+	}
+
+	virtual int32 MapRegisterIndex(int32 index) const
+	{
+		return index >= 0 && index < ARM64_REGISTER_COUNT
+			? fIndices[index] : -1;
+	}
+
+private:
+	int32	fIndices[ARM64_REGISTER_COUNT];
+};
+
