diff --git a/src/kits/debugger/arch/arm64/CpuStateArm64.cpp b/src/kits/debugger/arch/arm64/CpuStateArm64.cpp
new file mode 100644
index 00000000..f55e8e3d
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/CpuStateArm64.cpp
@@ -0,0 +1,211 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "CpuStateArm64.h"
+
+#include <new>
+
+#include <string.h>
+
+#include "Register.h"
+
+
+CpuStateArm64::CpuStateArm64()
+	:
+	fSetRegisters()
+{
+	memset(fIntRegisters, 0, sizeof(fIntRegisters));
+	memset(fSIMDRegisters, 0, sizeof(fSIMDRegisters));
+}
+
+
+CpuStateArm64::CpuStateArm64(const arm64_debug_cpu_state& state)
+	:
+	fSetRegisters()
+{
+	memset(fIntRegisters, 0, sizeof(fIntRegisters));
+	memset(fSIMDRegisters, 0, sizeof(fSIMDRegisters));
+
+	for (int32 i = 0; i < 30; i++)
+		SetIntRegister(ARM64_REGISTER_X0 + i, state.x[i]);
+	SetIntRegister(ARM64_REGISTER_LR, state.lr);
+	SetIntRegister(ARM64_REGISTER_SP, state.sp);
+	SetIntRegister(ARM64_REGISTER_PC, state.elr);
+	SetIntRegister(ARM64_REGISTER_CPSR, state.spsr);
+	SetIntRegister(ARM64_REGISTER_FPSR, state.fpsr);
+	SetIntRegister(ARM64_REGISTER_FPCR, state.fpcr);
+
+	for (int32 i = 0; i < 32; i++)
+		_SetSIMDRegister(ARM64_REGISTER_V0 + i, (const uint64*)&state.fp_q[i * 2]);
+}
+
+
+CpuStateArm64::~CpuStateArm64()
+{
+}
+
+
+status_t
+CpuStateArm64::Clone(CpuState*& _clone) const
+{
+	CpuStateArm64* newState = new(std::nothrow) CpuStateArm64();
+	if (newState == NULL)
+		return B_NO_MEMORY;
+
+	memcpy(newState->fIntRegisters, fIntRegisters, sizeof(fIntRegisters));
+	memcpy(newState->fSIMDRegisters, fSIMDRegisters, sizeof(fSIMDRegisters));
+	newState->fSetRegisters = fSetRegisters;
+
+	_clone = newState;
+	return B_OK;
+}
+
+
+status_t
+CpuStateArm64::UpdateDebugState(void* state, size_t size) const
+{
+	if (size != sizeof(arm64_debug_cpu_state))
+		return B_BAD_VALUE;
+
+	arm64_debug_cpu_state* armState = (arm64_debug_cpu_state*)state;
+
+	for (int32 i = 0; i < 30; i++)
+		armState->x[i] = IntRegisterValue(ARM64_REGISTER_X0 + i);
+	armState->lr = IntRegisterValue(ARM64_REGISTER_LR);
+	armState->sp = IntRegisterValue(ARM64_REGISTER_SP);
+	armState->elr = IntRegisterValue(ARM64_REGISTER_PC);
+	armState->spsr = IntRegisterValue(ARM64_REGISTER_CPSR);
+	armState->fpsr = IntRegisterValue(ARM64_REGISTER_FPSR);
+	armState->fpcr = IntRegisterValue(ARM64_REGISTER_FPCR);
+
+	for (int32 i = 0; i < 32; i++) {
+		if (IsRegisterSet(ARM64_REGISTER_V0 + i)) {
+			memcpy(&armState->fp_q[i * 2], fSIMDRegisters[i].value,
+				sizeof(arm64_simd_register));
+		} else
+			memset(&armState->fp_q[i * 2], 0, sizeof(arm64_simd_register));
+	}
+
+	return B_OK;
+}
+
+
+target_addr_t
+CpuStateArm64::InstructionPointer() const
+{
+	return IsRegisterSet(ARM64_REGISTER_PC)
+		? IntRegisterValue(ARM64_REGISTER_PC) : 0;
+}
+
+
+void
+CpuStateArm64::SetInstructionPointer(target_addr_t address)
+{
+	SetIntRegister(ARM64_REGISTER_PC, address);
+}
+
+
+target_addr_t
+CpuStateArm64::StackFramePointer() const
+{
+	return IsRegisterSet(ARM64_REGISTER_FP)
+		? IntRegisterValue(ARM64_REGISTER_FP) : 0;
+}
+
+
+target_addr_t
+CpuStateArm64::StackPointer() const
+{
+	return IsRegisterSet(ARM64_REGISTER_SP)
+		? IntRegisterValue(ARM64_REGISTER_SP) : 0;
+}
+
+
+bool
+CpuStateArm64::GetRegisterValue(const Register* reg, BVariant& _value) const
+{
+	int32 index = reg->Index();
+	if (!IsRegisterSet(index))
+		return false;
+
+	if (index < ARM64_INT_REGISTER_END) {
+		if (reg->BitSize() == 32)
+			_value.SetTo((uint32)fIntRegisters[index]);
+		else
+			_value.SetTo(fIntRegisters[index]);
+		return true;
+	}
+
+	if (index < ARM64_SIMD_REGISTER_END) {
+		_value.SetTo(fSIMDRegisters[index - ARM64_REGISTER_V0].value);
+		return true;
+	}
+
+	return false;
+}
+
+
+bool
+CpuStateArm64::SetRegisterValue(const Register* reg, const BVariant& value)
+{
+	int32 index = reg->Index();
+	if (index < 0)
+		return false;
+
+	if (index < ARM64_INT_REGISTER_END) {
+		fIntRegisters[index] = value.ToUInt64();
+	} else if (index < ARM64_SIMD_REGISTER_END) {
+		if (value.Size() > sizeof(arm64_simd_register))
+			return false;
+		arm64_simd_register& simd = fSIMDRegisters[index - ARM64_REGISTER_V0];
+		memset(&simd, 0, sizeof(simd));
+		memcpy(simd.value, value.ToPointer(), value.Size());
+	} else
+		return false;
+
+	fSetRegisters[index] = 1;
+	return true;
+}
+
+
+bool
+CpuStateArm64::IsRegisterSet(int32 index) const
+{
+	return index >= 0 && index < ARM64_REGISTER_COUNT && fSetRegisters[index];
+}
+
+
+uint64
+CpuStateArm64::IntRegisterValue(int32 index) const
+{
+	if (!IsRegisterSet(index) || index >= ARM64_INT_REGISTER_END)
+		return 0;
+
+	return fIntRegisters[index];
+}
+
+
+void
+CpuStateArm64::SetIntRegister(int32 index, uint64 value)
+{
+	if (index < 0 || index >= ARM64_INT_REGISTER_END)
+		return;
+
+	fIntRegisters[index] = value;
+	fSetRegisters[index] = 1;
+}
+
+
+void
+CpuStateArm64::_SetSIMDRegister(int32 index, const uint64* value)
+{
+	if (index < ARM64_REGISTER_V0 || index >= ARM64_SIMD_REGISTER_END)
+		return;
+
+	memcpy(fSIMDRegisters[index - ARM64_REGISTER_V0].value, value,
+		sizeof(arm64_simd_register));
+	fSetRegisters[index] = 1;
+}
diff --git a/src/kits/debugger/arch/arm64/CpuStateArm64.h b/src/kits/debugger/arch/arm64/CpuStateArm64.h
new file mode 100644
index 00000000..20f8903e
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/CpuStateArm64.h
@@ -0,0 +1,88 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef CPU_STATE_ARM64_H
+#define CPU_STATE_ARM64_H
+
+#include <bitset>
+
+#include <debugger.h>
+
+#include "CpuState.h"
+
+
+enum {
+	ARM64_REGISTER_X0 = 0,
+	// x1 - x28 follow
+	ARM64_REGISTER_FP = 29,		// x29
+	ARM64_REGISTER_LR = 30,		// x30
+	ARM64_REGISTER_SP = 31,
+	ARM64_REGISTER_PC,
+	ARM64_REGISTER_CPSR,
+	ARM64_REGISTER_FPSR,
+	ARM64_REGISTER_FPCR,
+
+	ARM64_INT_REGISTER_END,
+
+	ARM64_REGISTER_V0 = ARM64_INT_REGISTER_END,
+	// v1 - v31 follow
+
+	ARM64_SIMD_REGISTER_END = ARM64_REGISTER_V0 + 32,
+
+	ARM64_REGISTER_COUNT = ARM64_SIMD_REGISTER_END
+};
+
+
+#define ARM64_INT_REGISTER_COUNT ARM64_INT_REGISTER_END
+#define ARM64_SIMD_REGISTER_COUNT (ARM64_SIMD_REGISTER_END \
+	- ARM64_INT_REGISTER_END)
+
+
+struct arm64_simd_register {
+	uint64	value[2];	// low, high
+};
+
+
+class CpuStateArm64 : public CpuState {
+public:
+								CpuStateArm64();
+								CpuStateArm64(
+									const arm64_debug_cpu_state& state);
+	virtual						~CpuStateArm64();
+
+	virtual	status_t			Clone(CpuState*& _clone) const;
+
+	virtual	status_t			UpdateDebugState(void* state, size_t size)
+									const;
+
+	virtual	target_addr_t		InstructionPointer() const;
+	virtual	void				SetInstructionPointer(target_addr_t address);
+
+	virtual	target_addr_t		StackFramePointer() const;
+	virtual	target_addr_t		StackPointer() const;
+	virtual	bool				GetRegisterValue(const Register* reg,
+									BVariant& _value) const;
+	virtual	bool				SetRegisterValue(const Register* reg,
+									const BVariant& value);
+
+			bool				IsRegisterSet(int32 index) const;
+
+			uint64				IntRegisterValue(int32 index) const;
+			void				SetIntRegister(int32 index, uint64 value);
+
+private:
+			void				_SetSIMDRegister(int32 index,
+									const uint64* value);
+
+private:
+	typedef std::bitset<ARM64_REGISTER_COUNT> RegisterBitSet;
+
+private:
+			uint64				fIntRegisters[ARM64_INT_REGISTER_COUNT];
+			arm64_simd_register	fSIMDRegisters[ARM64_SIMD_REGISTER_COUNT];
+			RegisterBitSet		fSetRegisters;
+};
+
+
+#endif	// CPU_STATE_ARM64_H
diff --git a/src/kits/debugger/arch/arm64/disasm/DisassemblerArm64.cpp b/src/kits/debugger/arch/arm64/disasm/DisassemblerArm64.cpp
new file mode 100644
index 00000000..5a8c536b
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/disasm/DisassemblerArm64.cpp
@@ -0,0 +1,224 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+#include "DisassemblerArm64.h"
+
+#include <new>
+
+#include <stdio.h>
+#include <string.h>
+
+#include <capstone/capstone.h>
+
+#include "CpuStateArm64.h"
+#include "InstructionInfo.h"
+
+
+// All AArch64 instructions are 4 bytes, little endian.
+static const size_t kInstructionSize = 4;
+
+
+static inline int64
+sign_extend(uint64 value, int bits)
+{
+	uint64 sign = 1ULL << (bits - 1);
+	return (int64)((value ^ sign) - sign);
+}
+
+
+static inline uint32
+read_instruction(const uint8* code)
+{
+	return code[0] | (code[1] << 8) | (code[2] << 16) | ((uint32)code[3] << 24);
+}
+
+
+DisassemblerArm64::DisassemblerArm64()
+	:
+	fAddress(0),
+	fCode(NULL),
+	fCodeSize(0),
+	fOffset(0),
+	fHandle(0)
+{
+}
+
+
+DisassemblerArm64::~DisassemblerArm64()
+{
+	if (fHandle != 0) {
+		csh handle = fHandle;
+		cs_close(&handle);
+	}
+}
+
+
+status_t
+DisassemblerArm64::Init(target_addr_t address, const void* code,
+	size_t codeSize)
+{
+	fAddress = address;
+	fCode = (const uint8*)code;
+	fCodeSize = codeSize;
+	fOffset = 0;
+
+	if (fHandle == 0) {
+		csh handle;
+		if (cs_open(CS_ARCH_ARM64, CS_MODE_LITTLE_ENDIAN, &handle) != CS_ERR_OK)
+			return B_ERROR;
+		fHandle = handle;
+	}
+
+	return B_OK;
+}
+
+
+status_t
+DisassemblerArm64::GetNextInstruction(BString& line, target_addr_t& _address,
+	target_size_t& _size, bool& _breakpointAllowed)
+{
+	if (fOffset + kInstructionSize > fCodeSize)
+		return B_ENTRY_NOT_FOUND;
+
+	target_addr_t address = fAddress + fOffset;
+	uint32 instruction = read_instruction(fCode + fOffset);
+	fOffset += kInstructionSize;
+
+	status_t error = _Format(address, instruction, line);
+	if (error != B_OK)
+		return error;
+
+	_address = address;
+	_size = kInstructionSize;
+	_breakpointAllowed = true;
+	return B_OK;
+}
+
+
+status_t
+DisassemblerArm64::GetPreviousInstruction(target_addr_t nextAddress,
+	target_addr_t& _address, target_size_t& _size)
+{
+	if (nextAddress < fAddress + kInstructionSize
+		|| nextAddress > fAddress + fCodeSize) {
+		return B_BAD_VALUE;
+	}
+
+	_address = nextAddress - kInstructionSize;
+	_size = kInstructionSize;
+	return B_OK;
+}
+
+
+status_t
+DisassemblerArm64::GetNextInstructionInfo(InstructionInfo& _info,
+	CpuState* state)
+{
+	if (fOffset + kInstructionSize > fCodeSize)
+		return B_ENTRY_NOT_FOUND;
+
+	target_addr_t address = fAddress + fOffset;
+	uint32 instruction = read_instruction(fCode + fOffset);
+	fOffset += kInstructionSize;
+
+	int type = INSTRUCTION_TYPE_OTHER;
+	target_addr_t targetAddress = 0;
+	DecodeBranch(instruction, address, state, type, targetAddress);
+
+	BString line;
+	status_t error = _Format(address, instruction, line);
+	if (error != B_OK)
+		return error;
+
+	if (!_info.SetTo(address, targetAddress, kInstructionSize,
+			(instruction_type)type, true, line)) {
+		return B_NO_MEMORY;
+	}
+
+	return B_OK;
+}
+
+
+/*!	Classifies calls and jumps, and computes their target where possible
+	(for register targets only with a CPU state). Returns whether
+	\a instruction is a branch at all.
+*/
+/*static*/ bool
+DisassemblerArm64::DecodeBranch(uint32 instruction, target_addr_t address,
+	CpuState* state, int& _type, target_addr_t& _target)
+{
+	CpuStateArm64* armState = dynamic_cast<CpuStateArm64*>(state);
+	uint32 rn = (instruction >> 5) & 0x1f;
+
+	_type = INSTRUCTION_TYPE_OTHER;
+	_target = 0;
+
+	if ((instruction & 0x7c000000) == 0x14000000) {
+		// B, BL imm26
+		_type = (instruction & 0x80000000) != 0
+			? INSTRUCTION_TYPE_SUBROUTINE_CALL : INSTRUCTION_TYPE_JUMP;
+		_target = address + sign_extend(instruction & 0x03ffffff, 26) * 4;
+		return true;
+	}
+
+	if ((instruction & 0xff000010) == 0x54000000
+		|| (instruction & 0x7e000000) == 0x34000000) {
+		// B.cond, CBZ, CBNZ imm19
+		_type = INSTRUCTION_TYPE_JUMP;
+		_target = address + sign_extend((instruction >> 5) & 0x7ffff, 19) * 4;
+		return true;
+	}
+
+	if ((instruction & 0x7e000000) == 0x36000000) {
+		// TBZ, TBNZ imm14
+		_type = INSTRUCTION_TYPE_JUMP;
+		_target = address + sign_extend((instruction >> 5) & 0x3fff, 14) * 4;
+		return true;
+	}
+
+	// unconditional branch (register): BR, BLR, RET and their pointer
+	// authenticating variants
+	if ((instruction & 0xfe000000) == 0xd6000000) {
+		uint32 opc = (instruction >> 21) & 0xf;
+		if (opc == 1)
+			_type = INSTRUCTION_TYPE_SUBROUTINE_CALL;
+		else if (opc == 0 || opc == 2)
+			_type = INSTRUCTION_TYPE_JUMP;
+		else
+			return false;
+
+		if (armState != NULL && rn != 31)
+			_target = armState->IntRegisterValue(ARM64_REGISTER_X0 + rn);
+		return true;
+	}
+
+	return false;
+}
+
+
+status_t
+DisassemblerArm64::_Format(target_addr_t address, uint32 instruction,
+	BString& line)
+{
+	uint8 code[4];
+	memcpy(code, &instruction, sizeof(code));
+		// AArch64 hosts are little endian, as is the code
+
+	cs_insn* insn = NULL;
+	size_t count = cs_disasm((csh)fHandle, code, sizeof(code), address, 1,
+		&insn);
+	if (count == 1) {
+		line.SetToFormat("0x%016" B_PRIx64 ": %08" B_PRIx32 "  %s\t%s",
+			address, instruction, insn->mnemonic, insn->op_str);
+	} else {
+		line.SetToFormat("0x%016" B_PRIx64 ": %08" B_PRIx32 "  .inst\t0x%08"
+			B_PRIx32, address, instruction, instruction);
+	}
+
+	if (insn != NULL)
+		cs_free(insn, count);
+
+	return line.Length() > 0 ? B_OK : B_NO_MEMORY;
+}
