+extern "C" {
+#endif
+
+struct iframe;
+
+bool arm64_handle_breakpoint_exception(struct iframe* frame);
+void arm64_handle_single_step_exception(struct iframe* frame);
+void arm64_update_debug_state_at_kernel_exit(struct iframe* frame);
+void arch_step_over_software_breakpoint(addr_t address);
+
+#ifdef __cplusplus
+}
+#endif
+
+
 #endif /* _KERNEL_ARCH_ARM64_ARCH_USER_DEBUGGER_H_ */
