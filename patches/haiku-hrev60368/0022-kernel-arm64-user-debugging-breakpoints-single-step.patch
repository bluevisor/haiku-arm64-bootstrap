+// brk #ARM64_BREAKPOINT_IMMEDIATE, little endian
+#define BRK_INSTRUCTION (0xd4200000 | (ARM64_BREAKPOINT_IMMEDIATE << 5))
+const uint8 kArm64SoftwareBreakpoint[4] = {
+	BRK_INSTRUCTION & 0xff, (BRK_INSTRUCTION >> 8) & 0xff,
+	(BRK_INSTRUCTION >> 16) & 0xff, BRK_INSTRUCTION >> 24
+};
+
+#define MDSCR_SS	(1 << 0)
+	// software step enable
+
+static bool sCpuSingleStepping[SMP_MAX_CPUS];
+
+
+static iframe*
+arm64_get_user_iframe(Thread* thread)
+{
+	iframe_stack* iframes = &thread->arch_info.iframes;
+
+	// walk outwards from the innermost frame, skipping any kernel frames
+	for (int32 i = iframes->index - 1; i >= 0; i--) {
+		iframe* frame = iframes->frames[i];
+		if ((frame->spsr & PSR_M_MASK) == PSR_M_EL0t)
+			return frame;
+	}
+
+	return NULL;
+}
+
+
+static bool
+thread_wants_single_step(Thread* thread)
+{
+	return (thread->flags & THREAD_FLAGS_SINGLE_STEP) != 0
+		|| thread->debug_info.arch_info.step_over_address != 0;
+}
+
+
 void
 arch_clear_team_debug_info(struct arch_team_debug_info *info)
 {
+	info->dummy = 0;
 }
 
 
 void
 arch_destroy_team_debug_info(struct arch_team_debug_info *info)
 {
+	arch_clear_team_debug_info(info);
 }
 
 
 void
 arch_clear_thread_debug_info(struct arch_thread_debug_info *info)
 {
+	info->step_over_address = 0;
 }
 
 
 void
 arch_destroy_thread_debug_info(struct arch_thread_debug_info *info)
 {
+	arch_clear_thread_debug_info(info);
 }
 
 
+/*!	Arms (or disarms) single-stepping of the current thread's userland
+	frame, according to THREAD_FLAGS_SINGLE_STEP. The CPU side (MDSCR_EL1)
+	follows when the thread returns to userland.
+*/
 void
 arch_update_thread_single_step()
 {
+	Thread* thread = thread_get_current_thread();
+	iframe* frame = arm64_get_user_iframe(thread);
+	if (frame == NULL)
+		return;
+
+	// PSTATE.SS set on return: execute one instruction, then trap
+	if (thread_wants_single_step(thread))
+		frame->spsr |= PSR_SS;
+	else
+		frame->spsr &= ~(uint64)PSR_SS;
+}
+
+
+void
+arch_step_over_software_breakpoint(addr_t address)
+{
+	Thread* thread = thread_get_current_thread();
+	iframe* frame = arm64_get_user_iframe(thread);
+	if (frame == NULL)
+		return;
+
+	TRACE("arm64: thread %" B_PRId32 " steps over breakpoint %#lx\n",
+		thread->id, address);
+	thread->debug_info.arch_info.step_over_address = address;
+	frame->spsr |= PSR_SS;
+}
+
+
+static void
+set_cpu_state(iframe* frame, const debug_cpu_state* cpuState)
+{
+	memcpy(frame->x, cpuState->x, sizeof(frame->x));
+	frame->fp = cpuState->x[29];
+	frame->lr = cpuState->lr;
+	frame->sp = cpuState->sp;
+	frame->elr = cpuState->elr;
+
+	// only the condition flags may be changed
+	const uint64 kFlags = 0xf0000000;
+	frame->spsr = (frame->spsr & ~kFlags) | (cpuState->spsr & kFlags);
+
+	memcpy(frame->fpu.regs, cpuState->fp_q, sizeof(frame->fpu.regs));
+	frame->fpu.fpsr = cpuState->fpsr;
+	frame->fpu.fpcr = cpuState->fpcr;
 }
 
 
 void
 arch_set_debug_cpu_state(const debug_cpu_state *cpuState)
 {
+	if (iframe* frame = arm64_get_user_iframe(thread_get_current_thread()))
+		set_cpu_state(frame, cpuState);
 }
 
 
