+// User breakpoints are software only: "brk #ARM64_BREAKPOINT_IMMEDIATE".
+// There is no resume flag as on x86, so to continue from one, the kernel
+// takes it out, single-steps the thread over the original instruction and
+// puts it back (DEBUG_SOFTWARE_BREAKPOINT_STEP_OVER).
+#define ARM64_BREAKPOINT_IMMEDIATE			0x4842
+#define ARM64_DEBUGTRAP_IMMEDIATE			0xf000
+	// __builtin_debugtrap()
+
+extern const uint8 kArm64SoftwareBreakpoint[4];
+
+#define DEBUG_SOFTWARE_BREAKPOINT			kArm64SoftwareBreakpoint
+#define DEBUG_SOFTWARE_BREAKPOINT_SIZE		4
+#define DEBUG_SOFTWARE_BREAKPOINT_STEP_OVER	1
+
