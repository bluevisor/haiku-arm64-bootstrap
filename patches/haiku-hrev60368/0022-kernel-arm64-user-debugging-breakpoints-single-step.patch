+
+/*!	A "brk" from userland; interrupts are disabled.
+	Returns \c false, if this is a trap the program planted itself (like
+	__builtin_trap()), which the caller turns into a SIGTRAP.
+*/
+bool
+arm64_handle_breakpoint_exception(iframe* frame)
+{
+	uint32 immediate = frame->esr & 0xffff;
+	switch (immediate) {
+		case ARM64_BREAKPOINT_IMMEDIATE:
+			// one of ours: report it at the breakpoint's address
+			break;
+
+		case ARM64_DEBUGTRAP_IMMEDIATE:
+			// __builtin_debugtrap(): like int3 on x86, continuing goes on
+			// with the next instruction
+			frame->elr += 4;
+			break;
+
+		default:
+			return false;
+	}
+
+	enable_interrupts();
+	user_debug_breakpoint_hit(true);
+	return true;
+}
+
+
+/*!	A software step exception from userland; interrupts are disabled.
+*/
+void
+arm64_handle_single_step_exception(iframe* frame)
+{
+	Thread* thread = thread_get_current_thread();
+
+	enable_interrupts();
+
+	addr_t stepOverAddress = thread->debug_info.arch_info.step_over_address;
+	if (stepOverAddress != 0) {
+		thread->debug_info.arch_info.step_over_address = 0;
+		user_debug_finish_breakpoint_step_over((void*)stepOverAddress);
+	}
+
+	if ((thread->flags & THREAD_FLAGS_SINGLE_STEP) != 0)
+		user_debug_single_stepped();
+
+	// Otherwise this was a step over a breakpoint only, or a stale MDSCR_EL1
+	// from another thread: the kernel exit drops the step state.
+}
+
+
+/*!	Called right before returning to userland, with interrupts disabled.
+	MDSCR_EL1.SS is per CPU; only set it while returning to a thread that
+	is being single-stepped, or every thread would trap after its first
+	instruction.
+*/
+void
+arm64_update_debug_state_at_kernel_exit(iframe* frame)
+{
+	Thread* thread = thread_get_current_thread();
+	bool step = thread_wants_single_step(thread);
+
+	int32 cpu = smp_get_current_cpu();
+	if (sCpuSingleStepping[cpu] != step) {
+		uint64 mdscr = READ_SPECIALREG(MDSCR_EL1);
+		if (step)
+			mdscr |= MDSCR_SS;
+		else
+			mdscr &= ~(uint64)MDSCR_SS;
+		WRITE_SPECIALREG(MDSCR_EL1, mdscr);
+		asm volatile("isb" ::: "memory");
+		sCpuSingleStepping[cpu] = step;
+	}
+
+	if (!step)
+		frame->spsr &= ~(uint64)PSR_SS;
+}
