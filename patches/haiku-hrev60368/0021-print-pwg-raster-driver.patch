+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef PWG_CAP_H
+#define PWG_CAP_H
+
+
+#include <String.h>
+
+#include <vector>
+
+#include "PrinterCap.h"
+
+
+// Printer attributes cached on the printer's settings folder. They are read
+// from the printer with an IPP Get-Printer-Attributes request the first time
+// they are needed, and can be set by hand (e.g. with addattr).
+#define PWG_ATTR_RESOLUTIONS	"pwg:resolutions"
+	// "300,600": pwg-raster-document-resolution-supported, in dpi
+#define PWG_ATTR_TYPES			"pwg:types"
+	// "sgray_8,srgb_8": pwg-raster-document-type-supported
+#define PWG_ATTR_MEDIA			"pwg:media"
+	// media-supported, comma separated
+#define PWG_ATTR_MEDIA_DEFAULT	"pwg:media-default"
+#define PWG_ATTR_MODEL			"pwg:make-and-model"
+
+
+enum {
+	// PWG raster color spaces
+	kPWGColorSpaceRGB	= 1,
+	kPWGColorSpaceSGray	= 18,
+	kPWGColorSpaceSRGB	= 19
+};
+
+
+struct PWGPaperCap : public PaperCap {
+							PWGPaperCap(const char* label, bool isDefault,
+								JobData::Paper paper, float width,
+								float height, const char* mediaName);
+
+			BString			fMediaName;
+				// the PWG self-describing media name, e.g.
+				// "na_letter_8.5x11in"
+};
+
+
+class PWGCap : public PrinterCap {
+public:
+							PWGCap(const PrinterData* printerData);
+	virtual					~PWGCap();
+
+	virtual	int				CountCap(CapID category) const;
+	virtual	bool			Supports(CapID category) const;
+	virtual	const BaseCap**	GetCaps(CapID category) const;
+
+			// the PWG raster color space used for color and gray jobs
+			int32			ColorSpace(bool color) const;
+			const PWGPaperCap* FindPaper(JobData::Paper paper) const;
+
+	static	status_t		QueryPrinter(const char* uri, BNode& node,
+								BString& error);
+
+private:
+			void			_Load(BNode& node, bool query);
+
+			std::vector<const BaseCap*>	fPapers;
+			std::vector<const BaseCap*>	fPaperSources;
+			std::vector<const BaseCap*>	fResolutions;
+			std::vector<const BaseCap*>	fColors;
+			BString			fTypes;
+};
+
+
+#endif	// PWG_CAP_H
