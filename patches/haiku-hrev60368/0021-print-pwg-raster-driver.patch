@@ -0,0 +1,506 @@
+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "IppClient.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <NetworkAddress.h>
+#include <SecureSocket.h>
+#include <Socket.h>
+
+
+namespace IppClient {
+
+
+namespace {
+
+
+// Printers on the local network present self-signed certificates.
+class TrustingSecureSocket : public BSecureSocket {
+public:
+	virtual bool CertificateVerificationFailed(BCertificate&, const char*)
+	{
+		return true;
+	}
+};
+
+
+struct Location {
+	bool		tls;
+	BString		host;
+	uint16		port;
+	BString		path;
+};
+
+
+bool
+parse_uri(const char* uri, Location& location)
+{
+	const char* separator = strstr(uri, "://");
+	if (separator == NULL)
+		return false;
+
+	BString scheme(uri, separator - uri);
+	scheme.ToLower();
+	if (scheme == "ipp" || scheme == "http") {
+		location.tls = false;
+		location.port = scheme == "ipp" ? 631 : 80;
+	} else if (scheme == "ipps" || scheme == "https") {
+		location.tls = true;
+		location.port = scheme == "ipps" ? 631 : 443;
+	} else
+		return false;
+
+	const char* host = separator + 3;
+	const char* path = strchr(host, '/');
+	BString authority = path != NULL ? BString(host, path - host)
+		: BString(host);
+	location.path = path != NULL ? path : "/";
+
+	int32 colon = authority.FindLast(':');
+	if (colon >= 0 && authority.FindLast(']') < colon) {
+		location.port = atoi(authority.String() + colon + 1);
+		authority.Truncate(colon);
+	}
+	authority.RemoveAll("[");
+	authority.RemoveAll("]");
+	location.host = authority;
+	return location.host.Length() > 0 && location.port != 0;
+}
+
+
+uint32
+read_be(const std::string& data, size_t offset, size_t bytes)
+{
+	uint32 value = 0;
+	for (size_t i = 0; i < bytes; i++)
+		value = (value << 8) | (uint8)data[offset + i];
+	return value;
+}
+
+
+// Returns true once 'raw' holds a complete HTTP response.
+bool
+response_complete(const std::string& raw)
+{
+	size_t start = 0;
+	while (true) {
+		size_t end = raw.find("\r\n\r\n", start);
+		if (end == std::string::npos)
+			return false;
+		// skip informational "100 Continue" responses
+		if (raw.compare(start, 12, "HTTP/1.1 100") == 0
+			|| raw.compare(start, 12, "HTTP/1.0 100") == 0) {
+			start = end + 4;
+			continue;
+		}
+
+		BString headers(raw.data() + start, end - start);
+		headers.ToLower();
+		size_t bodyStart = end + 4;
+		int32 index = headers.FindFirst("\r\ncontent-length:");
+		if (index >= 0) {
+			size_t length = strtoul(headers.String() + index + 17, NULL, 10);
+			return raw.size() >= bodyStart + length;
+		}
+		if (headers.FindFirst("\r\ntransfer-encoding: chunked") >= 0)
+			return raw.find("\r\n0\r\n", bodyStart - 2) != std::string::npos;
+		// read until the server closes the connection
+		return false;
+	}
+}
+
+
+status_t
+split_response(const std::string& raw, int32& code, BString& statusLine,
+	std::string& body)
+{
+	size_t start = 0;
+	while (true) {
+		size_t lineEnd = raw.find("\r\n", start);
+		size_t end = raw.find("\r\n\r\n", start);
+		if (lineEnd == std::string::npos || end == std::string::npos)
+			return B_BAD_DATA;
+
+		statusLine.SetTo(raw.data() + start, lineEnd - start);
+		const char* space = strchr(statusLine.String(), ' ');
+		code = space != NULL ? atoi(space + 1) : 0;
+		if (code == 100) {
+			start = end + 4;
+			continue;
+		}
+
+		BString headers(raw.data() + start, end - start);
+		headers.ToLower();
+		size_t bodyStart = end + 4;
+
+		if (headers.FindFirst("\r\ntransfer-encoding: chunked") >= 0) {
+			body.clear();
+			size_t position = bodyStart;
+			while (position < raw.size()) {
+				size_t sizeEnd = raw.find("\r\n", position);
+				if (sizeEnd == std::string::npos)
+					return B_BAD_DATA;
+				size_t chunk = strtoul(raw.c_str() + position, NULL, 16);
+				if (chunk == 0)
+					break;
+				if (sizeEnd + 2 + chunk > raw.size())
+					return B_BAD_DATA;
+				body.append(raw, sizeEnd + 2, chunk);
+				position = sizeEnd + 2 + chunk + 2;
+			}
+			return B_OK;
+		}
+
+		int32 index = headers.FindFirst("\r\ncontent-length:");
+		if (index >= 0) {
+			size_t length = strtoul(headers.String() + index + 17, NULL, 10);
+			body.assign(raw, bodyStart, length);
+		} else
+			body.assign(raw, bodyStart, std::string::npos);
+		return B_OK;
+	}
+}
+
+
+status_t
+exchange(const Location& location, const std::string& ipp,
+	BPositionIO* document, off_t documentSize, std::string& raw,
+	BString& error, bigtime_t timeout)
+{
+	BNetworkAddress address;
+	status_t status = address.SetTo(location.host, location.port);
+	if (status != B_OK) {
+		error.SetToFormat("Cannot resolve the printer address %s.",
+			location.host.String());
+		return status;
+	}
+
+	BSocket* socket = location.tls
+		? new(std::nothrow) TrustingSecureSocket : new(std::nothrow) BSocket;
+	if (socket == NULL)
+		return B_NO_MEMORY;
+
+	status = socket->Connect(address, timeout);
+	if (status != B_OK) {
+		error.SetToFormat("Cannot connect to the printer at %s:%u: %s.",
+			location.host.String(), location.port, strerror(status));
+		delete socket;
+		return status;
+	}
+	socket->SetTimeout(timeout);
+
+	BString header;
+	header.SetToFormat("POST %s HTTP/1.1\r\n"
+		"Host: %s:%u\r\n"
+		"Content-Type: application/ipp\r\n"
+		"Content-Length: %" B_PRIdOFF "\r\n"
+		"Connection: close\r\n"
+		"\r\n", location.path.String(), location.host.String(),
+		location.port, (off_t)ipp.size() + documentSize);
+
+	status = socket->WriteExactly(header.String(), header.Length());
+	if (status == B_OK)
+		status = socket->WriteExactly(ipp.data(), ipp.size());
+
+	if (status == B_OK && document != NULL && documentSize > 0) {
+		const size_t kBufferSize = 64 * 1024;
+		char* buffer = (char*)malloc(kBufferSize);
+		if (buffer == NULL)
+			status = B_NO_MEMORY;
+		off_t position = 0;
+		while (status == B_OK && position < documentSize) {
+			ssize_t bytes = document->ReadAt(position, buffer, kBufferSize);
+			if (bytes <= 0) {
+				status = bytes < 0 ? (status_t)bytes : B_IO_ERROR;
+				break;
+			}
+			status = socket->WriteExactly(buffer, bytes);
+			position += bytes;
+		}
+		free(buffer);
+	}
+
+	// A printer may answer (and close) before it has read the whole
+	// request, e.g. "426 Upgrade Required": still read what it sent.
+	status_t writeStatus = status;
+
+	raw.clear();
+	char buffer[16 * 1024];
+	while (raw.size() < 16 * 1024 * 1024) {
+		ssize_t bytes = socket->Read(buffer, sizeof(buffer));
+		if (bytes <= 0)
+			break;
+		raw.append(buffer, bytes);
+		if (response_complete(raw))
+			break;
+	}
+	delete socket;
+
+	if (raw.empty()) {
+		if (writeStatus != B_OK) {
+			error.SetToFormat("Sending to the printer failed: %s.",
+				strerror(writeStatus));
+			return writeStatus;
+		}
+		error = "The printer closed the connection without an answer.";
+		return B_IO_ERROR;
+	}
+	return B_OK;
+}
+
+
+}	// namespace
+
+
+// #pragma mark - Request
+
+
+Request::Request(uint16 operation, const char* printerUri)
+	:
+	fFinished(false)
+{
+	static int32 sRequestID = 0;
+	int32 requestID = atomic_add(&sRequestID, 1) + 1;
+
+	const uint8 header[] = {
+		1, 1,	// IPP/1.1
+		(uint8)(operation >> 8), (uint8)operation,
+		(uint8)(requestID >> 24), (uint8)(requestID >> 16),
+		(uint8)(requestID >> 8), (uint8)requestID
+	};
+	fData.assign((const char*)header, sizeof(header));
+
+	BeginGroup(kOperationGroup);
+	AddString(kCharset, "attributes-charset", "utf-8");
+	AddString(kLanguage, "attributes-natural-language", "en");
+	AddString(kUri, "printer-uri", printerUri);
+}
+
+
+void
+Request::BeginGroup(uint8 tag)
+{
+	fData += (char)tag;
+}
+
+
+void
+Request::AddString(uint8 tag, const char* name, const char* value)
+{
+	_Add(tag, name, value, strlen(value));
+}
+
+
+void
+Request::AddValue(uint8 tag, const char* value)
+{
+	_Add(tag, "", value, strlen(value));
+}
+
+
+void
+Request::AddInteger(uint8 tag, const char* name, int32 value)
+{
+	const uint8 bytes[] = { (uint8)(value >> 24), (uint8)(value >> 16),
+		(uint8)(value >> 8), (uint8)value };
+	_Add(tag, name, bytes, sizeof(bytes));
+}
+
+
+const std::string&
+Request::Data()
+{
+	if (!fFinished) {
+		fData += (char)kEndOfAttributes;
+		fFinished = true;
+	}
+	return fData;
+}
+
+
+void
+Request::_Add(uint8 tag, const char* name, const void* value, size_t length)
+{
+	size_t nameLength = strlen(name);
+	fData += (char)tag;
+	fData += (char)(nameLength >> 8);
+	fData += (char)nameLength;
+	fData.append(name, nameLength);
+	fData += (char)(length >> 8);
+	fData += (char)length;
+	fData.append((const char*)value, length);
+}
+
+
+// #pragma mark - Attribute, Response
+
+
+int32
+Attribute::ResolutionAt(size_t index) const
+{
+	if (tag != kResolution || index >= values.size()
+		|| values[index].size() != 9) {
+		return 0;
+	}
+	int32 x = (int32)read_be(values[index], 0, 4);
+	uint8 units = (uint8)values[index][8];
+	if (units == 4)
+		return (int32)(x * 2.54 + 0.5);
+			// dots per centimeter
+	return x;
+}
+
+
+bool
+Attribute::BooleanAt(size_t index) const
+{
+	return index < values.size() && values[index].size() == 1
+		&& values[index][0] != 0;
+}
+
+
+int32
+Attribute::IntegerAt(size_t index) const
+{
+	if (index >= values.size() || values[index].size() != 4)
+		return 0;
+	return (int32)read_be(values[index], 0, 4);
+}
+
+
+const Attribute*
+Response::Find(const char* name) const
+{
+	for (size_t i = 0; i < attributes.size(); i++) {
+		if (attributes[i].name == name)
+			return &attributes[i];
+	}
+	return NULL;
+}
+
+
+BString
+Response::StatusText() const
+{
+	BString text;
+	const Attribute* message = Find("status-message");
+	if (message != NULL && !message->values.empty())
+		text = message->values[0].c_str();
+	else
+		text.SetToFormat("The printer answered with IPP status 0x%04x.",
+			status);
+	return text;
+}
+
+
+// #pragma mark - Send
+
+
+static status_t
+decode(const std::string& body, Response& response, BString& error)
+{
+	response.attributes.clear();
+	if (body.size() < 8) {
+		error = "The printer sent a truncated IPP response.";
+		return B_BAD_DATA;
+	}
+	response.status = (uint16)read_be(body, 2, 2);
+
+	uint8 group = 0;
+	size_t position = 8;
+	while (position < body.size()) {
+		uint8 tag = (uint8)body[position++];
+		if (tag == kEndOfAttributes)
+			break;
+		if (tag <= 0x0f) {
+			group = tag;
+			continue;
+		}
+		if (position + 2 > body.size())
+			break;
+		size_t nameLength = read_be(body, position, 2);
+		position += 2;
+		if (position + nameLength + 2 > body.size())
+			break;
+		std::string name(body, position, nameLength);
+		position += nameLength;
+		size_t valueLength = read_be(body, position, 2);
+		position += 2;
+		if (position + valueLength > body.size())
+			break;
+		std::string value(body, position, valueLength);
+		position += valueLength;
+
+		if (nameLength == 0 && !response.attributes.empty()) {
+			response.attributes.back().values.push_back(value);
+			continue;
+		}
+		Attribute attribute;
+		attribute.group = group;
+		attribute.tag = tag;
+		attribute.name = name;
+		attribute.values.push_back(value);
+		response.attributes.push_back(attribute);
+	}
+	return B_OK;
+}
+
+
+status_t
+Send(const char* uri, Request& request, BPositionIO* document,
+	Response& response, BString& error, bigtime_t timeout)
+{
+	Location location;
+	if (uri == NULL || !parse_uri(uri, location)) {
+		error.SetToFormat("\"%s\" is not an ipp:// or ipps:// printer URI.",
+			uri != NULL ? uri : "");
+		return B_BAD_VALUE;
+	}
+
+	off_t documentSize = 0;
+	if (document != NULL && document->GetSize(&documentSize) != B_OK)
+		documentSize = 0;
+
+	const std::string& ipp = request.Data();
+	for (int attempt = 0; attempt < 2; attempt++) {
+		std::string raw;
+		status_t status = exchange(location, ipp, document, documentSize, raw,
+			error, timeout);
+		if (status != B_OK)
+			return status;
+
+		int32 code;
+		BString statusLine;
+		std::string body;
+		if (split_response(raw, code, statusLine, body) != B_OK) {
+			error = "The printer sent a malformed HTTP response.";
+			return B_BAD_DATA;
+		}
+		if (code == 426 && !location.tls) {
+			// "Upgrade Required": the printer only talks IPP over TLS
+			location.tls = true;
+			continue;
+		}
+		if (code != 200) {
+			error.SetToFormat("The printer answered \"%s\".",
+				statusLine.String());
+			return B_ERROR;
+		}
+		return decode(body, response, error);
+	}
+
+	error = "The printer requires TLS but the TLS connection failed.";
+	return B_ERROR;
+}
+
+
+}	// namespace IppClient
