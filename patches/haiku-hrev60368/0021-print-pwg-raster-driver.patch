-		setRequestProperty("Content-Length", buf);
-		HttpURLConnection::setRequest();
-	}
-}
-
-void IppURLConnection::setContent()
-{
-	if (connected && __ippRequest) {
-		ostream &os = getOutputStream();
-		os << *__ippRequest;
-	}
-}
