+	{ JobData::kA5, "A5", "iso_a5_148x210mm", 419.53f, 595.28f },
+	{ JobData::kB5, "B5 (JIS)", "jis_b5_182x257mm", 515.91f, 728.50f },
+	{ JobData::kEnv10, "Envelope #10", "na_number-10_4.125x9.5in", 297,
+		684 },
+	{ JobData::kEnvDL, "Envelope DL", "iso_dl_110x220mm", 311.81f, 623.62f },
+	{ JobData::kJapanesePostcard, "Postcard (Hagaki)",
+		"jpn_hagaki_100x148mm", 283.46f, 419.53f },
+};
+
+
+static BString
+read_string_attr(BNode& node, const char* name, bool* exists = NULL)
+{
+	BString value;
+	status_t status = node.ReadAttrString(name, &value);
+	if (exists != NULL)
+		*exists = status == B_OK;
+	return value;
+}
+
+
+static bool
+list_contains(const BString& list, const char* item)
+{
+	BStringList items;
+	list.Split(",", true, items);
+	return items.HasString(item);
+}
+
+
+// #pragma mark - PWGPaperCap
+
+
+PWGPaperCap::PWGPaperCap(const char* label, bool isDefault,
+	JobData::Paper paper, float width, float height, const char* mediaName)
+	:
+	PaperCap(label, isDefault, paper, BRect(0, 0, width, height),
+		BRect(kMargin, kMargin, width - kMargin, height - kMargin)),
+	fMediaName(mediaName)
+{
+}
+
+
+// #pragma mark - PWGCap
+
+
+PWGCap::PWGCap(const PrinterData* printerData)
+	:
+	PrinterCap(printerData)
+{
+	string path;
+	BNode node;
+	if (printerData != NULL && printerData->GetPath(path))
+		node.SetTo(path.c_str());
+
+	_Load(node, true);
+}
+
+
+PWGCap::~PWGCap()
+{
+	for (size_t i = 0; i < fPapers.size(); i++)
+		delete fPapers[i];
+	for (size_t i = 0; i < fPaperSources.size(); i++)
+		delete fPaperSources[i];
+	for (size_t i = 0; i < fResolutions.size(); i++)
+		delete fResolutions[i];
+	for (size_t i = 0; i < fColors.size(); i++)
+		delete fColors[i];
+}
+
+
+/*static*/ status_t
+PWGCap::QueryPrinter(const char* uri, BNode& node, BString& error)
+{
+	IppClient::Request request(IppClient::kGetPrinterAttributes, uri);
+	request.AddString(IppClient::kKeyword, "requested-attributes",
+		"pwg-raster-document-resolution-supported");
+	request.AddValue(IppClient::kKeyword,
+		"pwg-raster-document-type-supported");
+	request.AddValue(IppClient::kKeyword, "media-supported");
+	request.AddValue(IppClient::kKeyword, "media-default");
+	request.AddValue(IppClient::kKeyword, "printer-make-and-model");
+
+	IppClient::Response response;
+	status_t status = IppClient::Send(uri, request, NULL, response, error,
+		5000000LL);
+	if (status != B_OK)
+		return status;
+	if (!response.Succeeded()) {
+		error = response.StatusText();
+		return B_ERROR;
+	}
+
+	const IppClient::Attribute* attribute
+		= response.Find("pwg-raster-document-resolution-supported");
+	if (attribute == NULL) {
+		error = "The printer does not accept PWG raster documents.";
+		return B_NOT_SUPPORTED;
+	}
+
+	BString resolutions;
+	for (size_t i = 0; i < attribute->values.size(); i++) {
+		int32 dpi = attribute->ResolutionAt(i);
+		if (dpi <= 0)
+			continue;
+		if (resolutions.Length() > 0)
+			resolutions << ",";
+		resolutions << dpi;
+	}
+	node.WriteAttrString(PWG_ATTR_RESOLUTIONS, &resolutions);
+
+	struct {
+		const char* ipp;
+		const char* attr;
+	} lists[] = {
+		{ "pwg-raster-document-type-supported", PWG_ATTR_TYPES },
+		{ "media-supported", PWG_ATTR_MEDIA },
+		{ "media-default", PWG_ATTR_MEDIA_DEFAULT },
+		{ "printer-make-and-model", PWG_ATTR_MODEL },
+	};
+	for (size_t i = 0; i < B_COUNT_OF(lists); i++) {
+		attribute = response.Find(lists[i].ipp);
+		if (attribute == NULL)
+			continue;
+		BString value;
+		for (size_t j = 0; j < attribute->values.size(); j++) {
+			if (j > 0)
+				value << ",";
+			value << attribute->values[j].c_str();
+		}
+		node.WriteAttrString(lists[i].attr, &value);
+	}
+	return B_OK;
+}
+
+
+void
+PWGCap::_Load(BNode& node, bool query)
+{
+	bool known = false;
+	if (node.InitCheck() == B_OK) {
+		read_string_attr(node, PWG_ATTR_RESOLUTIONS, &known);
+		if (!known && query) {
+			// first use: ask the printer what it can do
+			BString transport = read_string_attr(node, "transport");
+			BString uri = read_string_attr(node, "transport_address");
+			BString error;
+			if (transport == "IPP" && uri.Length() > 0)
+				known = QueryPrinter(uri, node, error) == B_OK;
+		}
+	}
+
+	BString resolutions = known
+		? read_string_attr(node, PWG_ATTR_RESOLUTIONS) : BString("300,600");
+	fTypes = known ? read_string_attr(node, PWG_ATTR_TYPES) : BString();
+	BString media = known ? read_string_attr(node, PWG_ATTR_MEDIA) : BString();
+	BString mediaDefault = known
+		? read_string_attr(node, PWG_ATTR_MEDIA_DEFAULT) : BString();
+
+	// Papers: the ones the printer lists, or a basic set if it lists none
+	bool anyMedia = false;
+	for (size_t i = 0; i < B_COUNT_OF(kMedia); i++) {
+		if (media.Length() > 0 && list_contains(media, kMedia[i].name))
+			anyMedia = true;
+	}
+	if (mediaDefault.Length() == 0)
+		mediaDefault = "na_letter_8.5x11in";
+	for (size_t i = 0; i < B_COUNT_OF(kMedia); i++) {
+		bool listed = anyMedia ? list_contains(media, kMedia[i].name)
+			: (kMedia[i].paper == JobData::kLetter
+				|| kMedia[i].paper == JobData::kLegal
+				|| kMedia[i].paper == JobData::kA4
+				|| kMedia[i].paper == JobData::kA5
+				|| mediaDefault == kMedia[i].name);
+		if (!listed)
+			continue;
+		bool isDefault = mediaDefault == kMedia[i].name;
+		fPapers.push_back(new PWGPaperCap(kMedia[i].label, isDefault,
+			kMedia[i].paper, kMedia[i].width, kMedia[i].height,
+			kMedia[i].name));
+	}
+	// without a default, libprint picks the first paper
+	if (fPapers.empty()) {
+		fPapers.push_back(new PWGPaperCap(kMedia[0].label, true,
+			kMedia[0].paper, kMedia[0].width, kMedia[0].height,
+			kMedia[0].name));
+	}
+
+	fPaperSources.push_back(new PaperSourceCap("Auto", true, JobData::kAuto));
+
+	// Resolutions: the best one up to 600 dpi is the default
+	BStringList items;
+	resolutions.Split(",", true, items);
+	int32 best = 0;
+	for (int32 i = 0; i < items.CountStrings(); i++) {
+		int32 dpi = atoi(items.StringAt(i));
+		if (dpi > best && dpi <= 600)
+			best = dpi;
+	}
+	for (int32 i = 0; i < items.CountStrings(); i++) {
+		int32 dpi = atoi(items.StringAt(i));
+		if (dpi <= 0)
+			continue;
+		BString label;
+		label << dpi << " dpi";
+		fResolutions.push_back(new ResolutionCap(label.String(), dpi == best,
+			dpi, dpi, dpi));
+	}
+	if (fResolutions.empty())
+		fResolutions.push_back(new ResolutionCap("300 dpi", true, 300, 300, 300));
+
+	// Colors
+	bool color = ColorSpace(true) != kPWGColorSpaceSGray;
+	bool gray = fTypes.Length() == 0 || list_contains(fTypes, "sgray_8");
+	if (color)
+		fColors.push_back(new ColorCap("Color", true, JobData::kColor));
+	if (gray || !color) {
+		fColors.push_back(new ColorCap("Shades of Gray", !color,
+			JobData::kMonochrome));
+	}
+}
+
+
+int32
+PWGCap::ColorSpace(bool color) const
+{
+	if (fTypes.Length() == 0)
+		return color ? kPWGColorSpaceSRGB : kPWGColorSpaceSGray;
+	if (color && list_contains(fTypes, "srgb_8"))
+		return kPWGColorSpaceSRGB;
+	if (color && list_contains(fTypes, "rgb_8"))
+		return kPWGColorSpaceRGB;
+	if (!list_contains(fTypes, "sgray_8") && list_contains(fTypes, "rgb_8"))
+		return kPWGColorSpaceRGB;
+	if (!list_contains(fTypes, "sgray_8") && list_contains(fTypes, "srgb_8"))
+		return kPWGColorSpaceSRGB;
+	return kPWGColorSpaceSGray;
+}
+
+
+const PWGPaperCap*
+PWGCap::FindPaper(JobData::Paper paper) const
+{
+	for (size_t i = 0; i < fPapers.size(); i++) {
+		const PWGPaperCap* cap = static_cast<const PWGPaperCap*>(fPapers[i]);
+		if (cap->fPaper == paper)
+			return cap;
+	}
+	return static_cast<const PWGPaperCap*>(fPapers[0]);
+}
+
+
+int
+PWGCap::CountCap(CapID category) const
+{
+	switch (category) {
+		case kPaper:
+			return fPapers.size();
+		case kPaperSource:
+			return fPaperSources.size();
+		case kResolution:
+			return fResolutions.size();
+		case kColor:
+			return fColors.size();
+		default:
+			return 0;
+	}
+}
+
+
+const BaseCap**
+PWGCap::GetCaps(CapID category) const
+{
+	const std::vector<const BaseCap*>* caps;
+	switch (category) {
+		case kPaper:
+			caps = &fPapers;
+			break;
+		case kPaperSource:
+			caps = &fPaperSources;
+			break;
+		case kResolution:
+			caps = &fResolutions;
+			break;
+		case kColor:
+			caps = &fColors;
+			break;
+		default:
+			return NULL;
+	}
+	return const_cast<const BaseCap**>(caps->data());
+}
+
+
+bool
+PWGCap::Supports(CapID category) const
+{
+	switch (category) {
+		case kPaper:
+		case kPaperSource:
+		case kResolution:
+		case kColor:
+			return true;
+		default:
+			return false;
+	}
+}
