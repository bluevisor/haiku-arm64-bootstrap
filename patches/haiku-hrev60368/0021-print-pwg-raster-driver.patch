diff --git a/src/add-ons/print/drivers/pwg/PWG.cpp b/src/add-ons/print/drivers/pwg/PWG.cpp
new file mode 100644
index 00000000..738cd045
--- /dev/null
+++ b/src/add-ons/print/drivers/pwg/PWG.cpp
@@ -0,0 +1,318 @@
+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "PWG.h"
+
+#include <string.h>
+
+#include <Bitmap.h>
+#include <InterfaceDefs.h>
+
+#include "JobData.h"
+#include "PWGCap.h"
+#include "PrinterData.h"
+
+
+static const size_t kHeaderSize = 1796;
+
+
+static void
+put_string(uint8* header, size_t offset, const char* value)
+{
+	strncpy((char*)header + offset, value, 63);
+}
+
+
+static void
+put_uint32(uint8* header, size_t offset, uint32 value)
+{
+	header[offset] = value >> 24;
+	header[offset + 1] = value >> 16;
+	header[offset + 2] = value >> 8;
+	header[offset + 3] = value;
+}
+
+
+PWGDriver::PWGDriver(BMessage* message, PrinterData* printerData,
+	const PrinterCap* printerCap)
+	:
+	GraphicsDriver(message, printerData, printerCap),
+	fPaper(NULL),
+	fColorSpace(kPWGColorSpaceSGray),
+	fBytesPerPixel(1),
+	fWidth(0),
+	fHeight(0),
+	fLeft(0),
+	fTop(0),
+	fLines(0),
+	fRasterStarted(false),
+	fHavePrevious(false),
+	fRepeat(0)
+{
+}
+
+
+bool
+PWGDriver::StartDocument()
+{
+	const PWGCap* cap = static_cast<const PWGCap*>(GetPrinterCap());
+	const JobData* job = GetJobData();
+
+	fPaper = cap->FindPaper(job->GetPaper());
+	fColorSpace = cap->ColorSpace(job->GetColor() == JobData::kColor);
+	fBytesPerPixel = fColorSpace == kPWGColorSpaceSGray ? 1 : 3;
+	fWidth = (int)(fPaper->fPaperRect.Width() * job->GetXres() / 72.0f + 0.5f);
+	fHeight = (int)(fPaper->fPaperRect.Height() * job->GetYres() / 72.0f
+		+ 0.5f);
+
+	try {
+		WriteSpoolData("RaS2", 4);
+		return true;
+	} catch (TransportException& exception) {
+		return false;
+	}
+}
+
+
+bool
+PWGDriver::StartPage(int)
+{
+	fRasterStarted = false;
+	fLines = 0;
+	fHavePrevious = false;
+	fRepeat = 0;
+	return true;
+}
+
+
+bool
+PWGDriver::NextBand(BBitmap* bitmap, BPoint* offset)
+{
+	try {
+		BRect bounds = bitmap->Bounds();
+		int bandWidth = bounds.IntegerWidth() + 1;
+		int height = bounds.IntegerHeight() + 1;
+		int y = (int)offset->y;
+		int pageHeight = GetPageHeight();
+		if (y + height > pageHeight)
+			height = pageHeight - y;
+
+		if (!fRasterStarted)
+			_BeginRaster(bandWidth);
+
+		int width = min_c(bandWidth, fWidth - fLeft);
+		const uint8* row = (const uint8*)bitmap->Bits();
+		int32 bytesPerRow = bitmap->BytesPerRow();
+		for (int i = 0; i < height; i++) {
+			memset(&fLine[0], 0xff, fLine.size());
+			if (width > 0) {
+				_ConvertRow(row, bitmap->ColorSpace(), width,
+					&fLine[fLeft * fBytesPerPixel]);
+			}
+			_AddLine();
+			row += bytesPerRow;
+		}
+
+		y += height;
+		if (y >= pageHeight) {
+			offset->x = -1.0;
+			offset->y = -1.0;
+		} else
+			offset->y += height;
+		return true;
+	} catch (TransportException& exception) {
+		return false;
+	}
+}
+
+
+bool
+PWGDriver::EndPage(int)
+{
+	try {
+		if (!fRasterStarted)
+			_BeginRaster(fWidth);
+		_AddBlankLines(fHeight - fLines);
+		_FlushLine();
+		return true;
+	} catch (TransportException& exception) {
+		return false;
+	}
+}
+
+
+bool
+PWGDriver::EndDocument(bool)
+{
+	return true;
+}
+
+
+void
+PWGDriver::_BeginRaster(int bandWidth)
+{
+	// the bitmap holds the printable area, centered on the sheet
+	fLeft = max_c(0, (fWidth - bandWidth) / 2);
+	fTop = max_c(0, (fHeight - GetPageHeight()) / 2);
+	fLine.assign(fWidth * fBytesPerPixel, 0xff);
+	fRasterStarted = true;
+
+	_WriteHeader();
+	_AddBlankLines(fTop);
+}
+
+
+void
+PWGDriver::_WriteHeader()
+{
+	const JobData* job = GetJobData();
+	uint8 header[kHeaderSize];
+	memset(header, 0, sizeof(header));
+
+	put_string(header, 0, "PwgRaster");
+	put_uint32(header, 276, job->GetXres());			// HWResolution
+	put_uint32(header, 280, job->GetYres());
+	put_uint32(header, 340, 1);							// NumCopies
+	put_uint32(header, 352, (uint32)(fPaper->fPaperRect.Width() + 0.5f));
+	put_uint32(header, 356, (uint32)(fPaper->fPaperRect.Height() + 0.5f));
+		// PageSize, in points
+	put_uint32(header, 372, fWidth);
+	put_uint32(header, 376, fHeight);
+	put_uint32(header, 384, 8);							// BitsPerColor
+	put_uint32(header, 388, 8 * fBytesPerPixel);		// BitsPerPixel
+	put_uint32(header, 392, fWidth * fBytesPerPixel);	// BytesPerLine
+	put_uint32(header, 396, 0);							// ColorOrder: chunky
+	put_uint32(header, 400, fColorSpace);
+	put_uint32(header, 420, fBytesPerPixel);			// NumColors
+	put_uint32(header, 452 + 4 * 1, 1);					// CrossFeedTransform
+	put_uint32(header, 452 + 4 * 2, 1);					// FeedTransform
+	put_uint32(header, 452 + 4 * 3, fLeft);				// ImageBoxLeft
+	put_uint32(header, 452 + 4 * 4, fTop);				// ImageBoxTop
+	put_uint32(header, 452 + 4 * 5, fWidth - fLeft);	// ImageBoxRight
+	put_uint32(header, 452 + 4 * 6, fHeight - fTop);	// ImageBoxBottom
+	put_uint32(header, 452 + 4 * 7, 0xffffff);			// AlternatePrimary
+	put_string(header, 1732, fPaper->fMediaName.String());
+		// PageSizeName
+
+	WriteSpoolData(header, sizeof(header));
+}
+
+
+void
+PWGDriver::_ConvertRow(const uint8* source, color_space space, int width,
+	uint8* destination) const
+{
+	const color_map* map = space == B_CMAP8 ? system_colors() : NULL;
+
+	for (int x = 0; x < width; x++) {
+		uint8 red, green, blue;
+		switch (space) {
+			case B_CMAP8:
+			{
+				const rgb_color& color = map->color_list[source[x]];
+				red = color.red;
+				green = color.green;
+				blue = color.blue;
+				break;
+			}
+			case B_GRAY8:
+				red = green = blue = source[x];
+				break;
+			default:
+				// B_RGB32 / B_RGBA32: blue, green, red, alpha in memory
+				blue = source[4 * x];
+				green = source[4 * x + 1];
+				red = source[4 * x + 2];
+				break;
+		}
+
+		if (fBytesPerPixel == 1) {
+			destination[x] = red == green && green == blue ? red
+				: (uint8)((red * 77 + green * 150 + blue * 29) >> 8);
+		} else {
+			destination[3 * x] = red;
+			destination[3 * x + 1] = green;
+			destination[3 * x + 2] = blue;
+		}
+	}
+}
+
+
+void
+PWGDriver::_AddLine()
+{
+	if (fLines >= fHeight)
+		return;
+	fLines++;
+
+	if (fHavePrevious && fRepeat < 255 && fLine == fPrevious) {
+		fRepeat++;
+		return;
+	}
+	_FlushLine();
+	fPrevious = fLine;
+	fHavePrevious = true;
+	fRepeat = 0;
+}
+
+
+void
+PWGDriver::_AddBlankLines(int count)
+{
+	memset(&fLine[0], 0xff, fLine.size());
+	for (int i = 0; i < count; i++)
+		_AddLine();
+}
+
+
+// Encodes the pending line: a repeat count, then runs of pixels, each
+// either one pixel repeated n + 1 times (n < 128) or 257 - n literal pixels
+// (n > 128).
+void
+PWGDriver::_FlushLine()
+{
+	if (!fHavePrevious)
+		return;
+	fHavePrevious = false;
+
+	const int bpp = fBytesPerPixel;
+	const uint8* line = &fPrevious[0];
+	fOutput.clear();
+	fOutput.push_back((uint8)fRepeat);
+
+	int x = 0;
+	while (x < fWidth) {
+		int run = 1;
+		while (x + run < fWidth && run < 128
+			&& memcmp(line + x * bpp, line + (x + run) * bpp, bpp) == 0) {
+			run++;
+		}
+		if (run > 1) {
+			fOutput.push_back((uint8)(run - 1));
+			fOutput.insert(fOutput.end(), line + x * bpp, line + (x + 1) * bpp);
+			x += run;
+			continue;
+		}
+
+		// literal pixels, up to the start of the next repeated pair
+		int count = 1;
+		while (x + count < fWidth && count < 128
+			&& !(x + count + 1 < fWidth
+				&& memcmp(line + (x + count) * bpp,
+					line + (x + count + 1) * bpp, bpp) == 0)) {
+			count++;
+		}
+		if (count == 1)
+			fOutput.push_back(0);
+		else
+			fOutput.push_back((uint8)(257 - count));
+		fOutput.insert(fOutput.end(), line + x * bpp,
+			line + (x + count) * bpp);
+		x += count;
+	}
+
+	WriteSpoolData(&fOutput[0], fOutput.size());
+}
