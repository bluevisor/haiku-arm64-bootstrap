+++ b/src/add-ons/print/drivers/pwg/PWG.h
@@ -0,0 +1,61 @@
+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef PWG_H
+#define PWG_H
+
+
+#include <vector>
+
+#include "GraphicsDriver.h"
+
+
+class PWGPaperCap;
+
+
+// Writes PWG Raster (PWG 5102.4, "image/pwg-raster"), the page format of
+// IPP Everywhere printers: an 8-bit gray or RGB bitmap of the whole sheet
+// per page, run-length compressed.
+class PWGDriver : public GraphicsDriver {
+public:
+						PWGDriver(BMessage* message, PrinterData* printerData,
+							const PrinterCap* printerCap);
+
+protected:
+	virtual	bool		StartDocument();
+	virtual	bool		StartPage(int page);
+	virtual	bool		NextBand(BBitmap* bitmap, BPoint* offset);
+	virtual	bool		EndPage(int page);
+	virtual	bool		EndDocument(bool success);
+
+private:
+			void		_BeginRaster(int bandWidth);
+			void		_WriteHeader();
+			void		_ConvertRow(const uint8* source, color_space space,
+							int width, uint8* destination) const;
+			void		_AddLine();
+			void		_AddBlankLines(int count);
+			void		_FlushLine();
+
+			const PWGPaperCap* fPaper;
+			int			fColorSpace;
+			int			fBytesPerPixel;
+			int			fWidth;
+			int			fHeight;
+				// pixels of the whole sheet
+			int			fLeft;
+			int			fTop;
+				// where the rendered (printable) area starts
+			int			fLines;
+			bool		fRasterStarted;
+
+			std::vector<uint8>	fLine;
+			std::vector<uint8>	fPrevious;
+			bool		fHavePrevious;
+			int			fRepeat;
+			std::vector<uint8>	fOutput;
+};
+
+
+#endif	// PWG_H
