+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef IPP_CLIENT_H
+#define IPP_CLIENT_H
+
+
+#include <DataIO.h>
+#include <String.h>
+
+#include <string>
+#include <vector>
+
+
+// A small IPP/1.1 client: encodes requests, sends them over HTTP to
+// ipp:// (plain, upgraded to TLS when the printer answers 426) or ipps://
+// (TLS) printer URIs, and decodes the response. Printers use self-signed
+// certificates, so certificate errors are ignored.
+namespace IppClient {
+
+
+enum {
+	kPrintJob				= 0x0002,
+	kValidateJob			= 0x0004,
+	kGetPrinterAttributes	= 0x000b
+};
+
+enum {
+	kOperationGroup			= 0x01,
+	kJobGroup				= 0x02,
+	kEndOfAttributes		= 0x03,
+	kPrinterGroup			= 0x04
+};
+
+enum {
+	kInteger				= 0x21,
+	kBoolean				= 0x22,
+	kEnum					= 0x23,
+	kResolution				= 0x32,
+	kText					= 0x41,
+	kName					= 0x42,
+	kKeyword				= 0x44,
+	kUri					= 0x45,
+	kCharset				= 0x47,
+	kLanguage				= 0x48,
+	kMimeMediaType			= 0x49
+};
+
+
+class Request {
+public:
+							Request(uint16 operation, const char* printerUri);
+
+			void			AddString(uint8 tag, const char* name,
+								const char* value);
+				// a further value of the attribute added last
+			void			AddValue(uint8 tag, const char* value);
+			void			AddInteger(uint8 tag, const char* name,
+								int32 value);
+			void			BeginGroup(uint8 tag);
+
+			const std::string& Data();
+
+private:
+			void			_Add(uint8 tag, const char* name,
+								const void* value, size_t length);
+
+			std::string		fData;
+			bool			fFinished;
+};
+
+
+struct Attribute {
+	uint8					group;
+	uint8					tag;
+	std::string				name;
+	std::vector<std::string> values;
+
+			// for kResolution values: dots per inch (0 if not a resolution)
+			int32			ResolutionAt(size_t index) const;
+			bool			BooleanAt(size_t index) const;
+			int32			IntegerAt(size_t index) const;
+};
+
+
+struct Response {
+	uint16					status;
+	std::vector<Attribute>	attributes;
+
+			const Attribute* Find(const char* name) const;
+			bool			Succeeded() const { return status < 0x0100; }
+			BString			StatusText() const;
+};
+
+
+// Sends an IPP request and decodes the response. 'document' (may be NULL)
+// is appended after the encoded request, as Print-Job needs.
+status_t	Send(const char* uri, Request& request, BPositionIO* document,
+				Response& response, BString& error,
+				bigtime_t timeout = 15000000LL);
+
+
+}	// namespace IppClient
+
+
+#endif	// IPP_CLIENT_H
