-inline bool is_contenttype_ipp(const char *s)
-{
-	return strnicmp(s, "application/ipp", 15) ? false : true;
-}
-
-void IppURLConnection::getContent()
-{
-	if (connected) {
-		if (getResponseCode() == HTTP_OK && is_contenttype_ipp(getContentType())) {
