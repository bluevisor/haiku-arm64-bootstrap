-	if (iss && iss->good()) {
-		int fsize = size;
-		if (fsize < 0) {
-			streampos pos = iss->tellg();
-			iss->seekg(0, ios::end);
-			fsize = iss->tellg();
-			iss->seekg(pos, ios::beg);
