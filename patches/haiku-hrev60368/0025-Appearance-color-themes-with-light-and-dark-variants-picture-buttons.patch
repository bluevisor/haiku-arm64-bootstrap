+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef COLOR_THEMES_H
+#define COLOR_THEMES_H
+
+
+#include <GraphicsDefs.h>
+#include <Message.h>
+
+
+// A theme is a light and a dark variant of a few accent colors (window tab,
+// progress/selection accent and a hue mixed into the background colors) on
+// top of the system's built-in light or dark color set.
+struct ColorThemeVariant {
+	rgb_color	tab;
+	rgb_color	tabText;
+	rgb_color	accent;
+	rgb_color	tint;
+	float		tintAmount;
+};
+
+struct ColorTheme {
+	const char*			name;
+	bool				stock;
+		// the built-in color sets unchanged
+	ColorThemeVariant	light;
+	ColorThemeVariant	dark;
+};
+
+static const int32 kColorThemeCount = 6;
+
+const ColorTheme& color_theme_at(int32 index);
+
+// Fills colors with the full color set of a theme. The desktop color is the
+// current one: it belongs to Backgrounds.
+void get_theme_colors(BMessage* colors, int32 theme, bool dark);
+
+// The theme (and variant) a color set was made from, or -1.
+int32 match_color_theme(const BMessage& colors, bool& dark);
+
+
+#endif	// COLOR_THEMES_H
