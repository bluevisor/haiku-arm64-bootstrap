+
+
+#include "ColorThemes.h"
+
+#include <Catalog.h>
+#include <HSL.h>
+#include <InterfaceDefs.h>
+
+#include "Colors.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "Colors tab"
+
+
+static const ColorTheme kColorThemes[kColorThemeCount] = {
+	{ B_TRANSLATE_MARK("Haiku"), true, {}, {} },
+	{ B_TRANSLATE_MARK("Ocean"), false,
+		{ {84, 148, 226, 255}, {255, 255, 255, 255}, {0, 112, 224, 255},
+			{40, 110, 200, 255}, 0.05f },
+		{ {40, 104, 184, 255}, {255, 255, 255, 255}, {64, 156, 255, 255},
+			{40, 90, 170, 255}, 0.12f } },
+	{ B_TRANSLATE_MARK("Forest"), false,
+		{ {132, 196, 116, 255}, {16, 32, 16, 255}, {46, 150, 72, 255},
+			{70, 150, 70, 255}, 0.05f },
+		{ {58, 128, 72, 255}, {255, 255, 255, 255}, {76, 186, 104, 255},
+			{50, 120, 60, 255}, 0.10f } },
+	{ B_TRANSLATE_MARK("Graphite"), false,
+		{ {196, 198, 204, 255}, {0, 0, 0, 255}, {104, 114, 132, 255},
+			{120, 130, 150, 255}, 0.03f },
+		{ {84, 88, 96, 255}, {255, 255, 255, 255}, {150, 160, 178, 255},
+			{90, 100, 120, 255}, 0.06f } },
+	{ B_TRANSLATE_MARK("Sunset"), false,
+		{ {246, 140, 108, 255}, {32, 16, 8, 255}, {226, 88, 64, 255},
+			{230, 120, 80, 255}, 0.05f },
+		{ {196, 84, 72, 255}, {255, 255, 255, 255}, {250, 120, 92, 255},
+			{170, 70, 60, 255}, 0.10f } },
+	{ B_TRANSLATE_MARK("Lavender"), false,
+		{ {180, 156, 232, 255}, {20, 10, 40, 255}, {128, 92, 220, 255},
+			{140, 110, 220, 255}, 0.05f },
+		{ {112, 84, 184, 255}, {255, 255, 255, 255}, {160, 124, 250, 255},
+			{100, 70, 170, 255}, 0.12f } },
+};
+
+
+static rgb_color
+mix(rgb_color a, rgb_color b, float amount)
+{
+	rgb_color result;
+	result.red = (uint8)(a.red + (b.red - a.red) * amount + 0.5f);
+	result.green = (uint8)(a.green + (b.green - a.green) * amount + 0.5f);
+	result.blue = (uint8)(a.blue + (b.blue - a.blue) * amount + 0.5f);
+	result.alpha = 255;
+	return result;
+}
+
+
+static rgb_color
+get(const BMessage& colors, color_which which)
+{
+	return colors.GetColor(ui_color_name(which), make_color(0, 0, 0));
+}
+
+
+static void
+set(BMessage& colors, color_which which, rgb_color color)
+{
+	colors.SetColor(ui_color_name(which), color);
+}
+
+
+const ColorTheme&
+color_theme_at(int32 index)
+{
+	if (index < 0 || index >= kColorThemeCount)
+		index = 0;
+	return kColorThemes[index];
+}
+
+
+void
+get_theme_colors(BMessage* _colors, int32 index, bool dark)
+{
+	BMessage& colors = *_colors;
+	colors.MakeEmpty();
+	get_system_colors(&colors, dark);
+	set(colors, B_DESKTOP_COLOR, ui_color(B_DESKTOP_COLOR));
+
+	const ColorTheme& theme = color_theme_at(index);
+	if (theme.stock)
+		return;
+
+	const ColorThemeVariant& variant = dark ? theme.dark : theme.light;
+
+	// neutral inactive tabs; the stock dark set's are warm, to go with amber
+	if (dark) {
+		set(colors, B_WINDOW_INACTIVE_TAB_COLOR, make_color(64, 64, 66));
+		set(colors, B_WINDOW_INACTIVE_BORDER_COLOR, make_color(64, 64, 66));
+	}
+
+	// a hint of the theme's hue in the background colors
+	const color_which tinted[] = {
+		B_PANEL_BACKGROUND_COLOR,
+		B_MENU_BACKGROUND_COLOR,
+		B_MENU_SELECTED_BACKGROUND_COLOR,
+		B_CONTROL_BACKGROUND_COLOR,
+		B_CONTROL_BORDER_COLOR,
+		B_DOCUMENT_BACKGROUND_COLOR,
+		B_LIST_BACKGROUND_COLOR,
+		B_SCROLL_BAR_THUMB_COLOR,
+		B_WINDOW_INACTIVE_TAB_COLOR,
+		B_WINDOW_INACTIVE_BORDER_COLOR,
+		B_TOOL_TIP_BACKGROUND_COLOR,
+	};
+	for (size_t i = 0; i < B_COUNT_OF(tinted); i++) {
+		set(colors, tinted[i],
+			mix(get(colors, tinted[i]), variant.tint, variant.tintAmount));
+	}
+
+	set(colors, B_WINDOW_TAB_COLOR, variant.tab);
+	set(colors, B_WINDOW_BORDER_COLOR, variant.tab);
+	set(colors, B_WINDOW_TEXT_COLOR, variant.tabText);
+
+	// the accent: progress bars, selections, check marks, keyboard focus
+	set(colors, B_STATUS_BAR_COLOR, variant.accent);
+	set(colors, B_LIST_SELECTED_BACKGROUND_COLOR,
+		mix(get(colors, B_LIST_SELECTED_BACKGROUND_COLOR), variant.accent, 0.4f));
+	set(colors, B_MENU_SELECTED_BACKGROUND_COLOR,
+		mix(get(colors, B_MENU_SELECTED_BACKGROUND_COLOR), variant.accent, 0.3f));
+	set(colors, B_LINK_TEXT_COLOR, mix(variant.accent,
+		dark ? make_color(255, 255, 255) : make_color(0, 0, 0), 0.15f));
+
+	const hsl_color accent = hsl_color::from_rgb(variant.accent);
+	hsl_color highlight = accent;
+	highlight.saturation = max_c(0.2f, highlight.saturation / 2.f);
+	set(colors, B_CONTROL_HIGHLIGHT_COLOR, highlight.to_rgb());
+
+	hsl_color mark = accent;
+	mark.saturation = max_c(0.2f, mark.saturation * 0.67f);
+	mark.lightness = max_c(0.25f, mark.lightness * 0.55f);
+	if (dark)
+		mark.lightness = min_c(0.75f, accent.lightness * 1.1f);
+	set(colors, B_CONTROL_MARK_COLOR, mark.to_rgb());
+
+	hsl_color navigation = accent;
+	navigation.lightness = dark ? max_c(0.55f, accent.lightness)
+		: min_c(0.45f, accent.lightness);
+	set(colors, B_KEYBOARD_NAVIGATION_COLOR, navigation.to_rgb());
+}
+
+
+int32
+match_color_theme(const BMessage& colors, bool& _dark)
+{
+	const color_which compared[] = {
+		B_WINDOW_TAB_COLOR,
+		B_PANEL_BACKGROUND_COLOR,
+		B_STATUS_BAR_COLOR,
+	};
+
+	for (int32 index = 0; index < kColorThemeCount; index++) {
+		for (int dark = 0; dark < 2; dark++) {
+			BMessage theme;
+			get_theme_colors(&theme, index, dark != 0);
+			bool same = true;
+			for (size_t i = 0; i < B_COUNT_OF(compared) && same; i++)
+				same = get(theme, compared[i]) == get(colors, compared[i]);
+			if (same) {
+				_dark = dark != 0;
+				return index;
+			}
+		}
+	}
+	return -1;
+}
