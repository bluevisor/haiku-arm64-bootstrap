@@ -0,0 +1,214 @@
+/*
+ * Copyright 2026 Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "ThemeButton.h"
+
+#include <GradientLinear.h>
+#include <InterfaceDefs.h>
+#include <LayoutUtils.h>
+#include <Region.h>
+#include <Window.h>
+
+
+static const float kThumbnailWidth = 76;
+static const float kThumbnailHeight = 50;
+static const float kRing = 3;
+static const float kLabelSpacing = 4;
+
+
+ThemeButton::ThemeButton(const char* name, const char* label,
+	BMessage* message)
+	:
+	BControl(name, label, message, B_WILL_DRAW | B_NAVIGABLE)
+{
+	SetViewUIColor(B_PANEL_BACKGROUND_COLOR);
+	SetLowUIColor(B_PANEL_BACKGROUND_COLOR);
+}
+
+
+void
+ThemeButton::SetColors(const BMessage& colors)
+{
+	fColors = colors;
+	Invalidate();
+}
+
+
+rgb_color
+ThemeButton::_Color(color_which which) const
+{
+	return fColors.GetColor(ui_color_name(which), ui_color(which));
+}
+
+
+BRect
+ThemeButton::_ThumbnailFrame() const
+{
+	BRect frame(0, 0, kThumbnailWidth - 1, kThumbnailHeight - 1);
+	frame.OffsetBy(floorf((Bounds().Width() - kThumbnailWidth) / 2), kRing);
+	return frame;
+}
+
+
+void
+ThemeButton::_DrawWindow(BRect frame, bool active)
+{
+	const float tabHeight = 7;
+	BRect tab(frame.left, frame.top, frame.left + floorf(frame.Width() * 0.55f),
+		frame.top + tabHeight - 1);
+	BRect body(frame.left, tab.bottom + 1, frame.right, frame.bottom);
+
+	SetHighColor(_Color(active ? B_WINDOW_TAB_COLOR : B_WINDOW_INACTIVE_TAB_COLOR));
+	FillRect(tab);
+	SetHighColor(_Color(active ? B_WINDOW_TEXT_COLOR : B_WINDOW_INACTIVE_TEXT_COLOR));
+	FillRect(BRect(tab.left + 4, tab.top + 3, tab.left + tab.Width() * 0.6f,
+		tab.top + 4));
+
+	SetHighColor(_Color(B_PANEL_BACKGROUND_COLOR));
+	FillRect(body);
+	SetHighColor(_Color(active ? B_WINDOW_BORDER_COLOR
+		: B_WINDOW_INACTIVE_BORDER_COLOR));
+	StrokeRect(body);
+
+	if (!active)
+		return;
+
+	// a text line, a progress bar and a button
+	BRect inside = body.InsetByCopy(4, 3);
+	SetHighColor(_Color(B_PANEL_TEXT_COLOR));
+	FillRect(BRect(inside.left, inside.top + 1, inside.left + inside.Width() * 0.7f,
+		inside.top + 1));
+
+	BRect bar(inside.left, inside.top + 5, inside.right, inside.top + 8);
+	SetHighColor(_Color(B_CONTROL_BACKGROUND_COLOR));
+	FillRect(bar);
+	SetHighColor(_Color(B_STATUS_BAR_COLOR));
+	FillRect(BRect(bar.left, bar.top, bar.left + bar.Width() * 0.6f, bar.bottom));
+	SetHighColor(_Color(B_CONTROL_BORDER_COLOR));
+	StrokeRect(bar);
+
+	BRect button(inside.right - 16, bar.bottom + 3, inside.right,
+		min_c(bar.bottom + 9, inside.bottom));
+	SetHighColor(_Color(B_CONTROL_BACKGROUND_COLOR));
+	FillRoundRect(button, 2, 2);
+	SetHighColor(_Color(B_KEYBOARD_NAVIGATION_COLOR));
+	StrokeRoundRect(button, 2, 2);
+}
+
+
+void
+ThemeButton::Draw(BRect updateRect)
+{
+	const BRect thumbnail = _ThumbnailFrame();
+	const rgb_color panel = ui_color(B_PANEL_BACKGROUND_COLOR);
+
+	SetHighColor(panel);
+	FillRect(updateRect);
+
+	// selection ring, and a thin one for keyboard focus
+	if (Value() == B_CONTROL_ON || (IsFocus() && Window()->IsActive())) {
+		// the selection in the current accent, keyboard focus as usual
+		SetHighColor(ui_color(Value() == B_CONTROL_ON
+			? B_STATUS_BAR_COLOR : B_KEYBOARD_NAVIGATION_COLOR));
+		SetPenSize(Value() == B_CONTROL_ON ? kRing : 1);
+		StrokeRoundRect(thumbnail.InsetByCopy(-kRing + 0.5f, -kRing + 0.5f),
+			7, 7);
+		SetPenSize(1);
+	}
+
+	// the desktop: a soft gradient in the theme's accent
+	const rgb_color accent = _Color(B_STATUS_BAR_COLOR);
+	const bool dark = _Color(B_PANEL_BACKGROUND_COLOR).IsDark();
+	BGradientLinear gradient(thumbnail.LeftTop(), thumbnail.RightBottom());
+	gradient.AddColor(tint_color(accent, dark ? B_DARKEN_2_TINT : 0.4f), 0);
+	gradient.AddColor(tint_color(accent, dark ? B_DARKEN_4_TINT : 0.85f), 255);
+	FillRoundRect(thumbnail, 5, 5, gradient);
+
+	BRegion clip(thumbnail.InsetByCopy(1, 1));
+	ConstrainClippingRegion(&clip);
+	_DrawWindow(BRect(thumbnail.left + 5, thumbnail.top + 5,
+		thumbnail.left + floorf(thumbnail.Width() * 0.6f),
+		thumbnail.top + floorf(thumbnail.Height() * 0.55f)), false);
+	_DrawWindow(BRect(thumbnail.left + floorf(thumbnail.Width() * 0.28f),
+		thumbnail.top + floorf(thumbnail.Height() * 0.32f),
+		thumbnail.right - 5, thumbnail.bottom + 2), true);
+	ConstrainClippingRegion(NULL);
+
+	SetHighColor(tint_color(panel, panel.IsDark() ? 0.6f : B_DARKEN_2_TINT));
+	StrokeRoundRect(thumbnail, 5, 5);
+
+	// the label
+	BFont font(Value() == B_CONTROL_ON ? be_bold_font : be_plain_font);
+	SetFont(&font);
+	font_height height;
+	font.GetHeight(&height);
+	const char* label = Label() != NULL ? Label() : "";
+	const float width = font.StringWidth(label);
+	SetHighColor(ui_color(B_PANEL_TEXT_COLOR));
+	if (!IsEnabled())
+		SetHighColor(tint_color(HighColor(), panel.IsDark() ? 0.6f : 0.4f));
+	DrawString(label, BPoint(floorf((Bounds().Width() - width) / 2),
+		thumbnail.bottom + kRing + kLabelSpacing + ceilf(height.ascent)));
+}
+
+
+void
+ThemeButton::MouseDown(BPoint where)
+{
+	if (!IsEnabled())
+		return;
+	if (Value() != B_CONTROL_ON)
+		Invoke();
+}
+
+
+void
+ThemeButton::KeyDown(const char* bytes, int32 numBytes)
+{
+	if (numBytes == 1 && (bytes[0] == B_SPACE || bytes[0] == B_ENTER)) {
+		if (IsEnabled() && Value() != B_CONTROL_ON)
+			Invoke();
+		return;
+	}
+	BControl::KeyDown(bytes, numBytes);
+}
+
+
+void
+ThemeButton::SetValue(int32 value)
+{
+	if (value != Value()) {
+		BControl::SetValueNoUpdate(value);
+		Invalidate();
+	}
+}
+
+
+BSize
+ThemeButton::MinSize()
+{
+	font_height height;
+	be_bold_font->GetHeight(&height);
+	const float labelWidth = Label() != NULL ? be_bold_font->StringWidth(Label()) : 0;
+	BSize size(max_c(kThumbnailWidth + 2 * kRing, ceilf(labelWidth) + 4),
+		kThumbnailHeight + 2 * kRing + kLabelSpacing
+			+ ceilf(height.ascent + height.descent));
+	return BLayoutUtils::ComposeSize(ExplicitMinSize(), size);
+}
+
+
+BSize
+ThemeButton::MaxSize()
+{
+	return BLayoutUtils::ComposeSize(ExplicitMaxSize(), MinSize());
+}
+
+
+BSize
+ThemeButton::PreferredSize()
+{
+	return BLayoutUtils::ComposeSize(ExplicitPreferredSize(), MinSize());
+}
