+class ThemeButton : public BControl {
+public:
+								ThemeButton(const char* name,
+									const char* label, BMessage* message);
+
+			void				SetColors(const BMessage& colors);
+
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				MouseDown(BPoint where);
+	virtual	void				KeyDown(const char* bytes, int32 numBytes);
+	virtual	void				SetValue(int32 value);
+
+	virtual	BSize				MinSize();
+	virtual	BSize				MaxSize();
+	virtual	BSize				PreferredSize();
+
+private:
+			rgb_color			_Color(color_which which) const;
+			BRect				_ThumbnailFrame() const;
+			void				_DrawWindow(BRect frame, bool active);
+
+private:
+			BMessage			fColors;
+};
