+#ifndef _MOUSE_NATURAL_SCROLLING_H
+#define _MOUSE_NATURAL_SCROLLING_H
+
+
+#include <InputServerTypes.h>
+#include <Message.h>
+
+
+// Natural scrolling reverses the wheel of mice and tablets, so the content
+// follows the fingers on a scroll wheel or a host trackpad the way it does
+// on a touchpad (whose own setting is in touchpad_settings.h). The
+// input_server keeps it per device, next to the other mouse settings.
+
+static const bool kDefaultNaturalScrolling = true;
+
+status_t _control_input_server_(BMessage* command, BMessage* reply);
+
+
+static inline status_t
+get_mouse_natural_scrolling(const char* mouseName, bool* naturalScrolling)
+{
+	BMessage command(IS_GET_MOUSE_NATURAL_SCROLLING);
+	BMessage reply;
+	if (mouseName != NULL)
+		command.AddString("mouse_name", mouseName);
+
+	status_t status = _control_input_server_(&command, &reply);
+	if (status != B_OK)
+		return status;
+
+	return reply.FindBool("natural_scrolling", naturalScrolling);
+}
+
+
+static inline status_t
+set_mouse_natural_scrolling(const char* mouseName, bool naturalScrolling)
+{
+	BMessage command(IS_SET_MOUSE_NATURAL_SCROLLING);
+	BMessage reply;
+	if (mouseName != NULL)
+		command.AddString("mouse_name", mouseName);
+	command.AddBool("natural_scrolling", naturalScrolling);
+
+	return _control_input_server_(&command, &reply);
+}
+
+
+#endif	/* _MOUSE_NATURAL_SCROLLING_H */
