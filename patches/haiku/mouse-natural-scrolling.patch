+status_t
+InputServer::HandleGetSetMouseNaturalScrolling(BMessage* message,
+	BMessage* reply)
+{
+	BString mouseName;
+	message->FindString("mouse_name", &mouseName);
+
+	MouseSettings* settings = _GetSettingsForMouse(mouseName);
+
+	bool naturalScrolling;
+	if (message->FindBool("natural_scrolling", &naturalScrolling) == B_OK) {
+		if (settings == NULL) {
+			BList allSettings;
+			_RunningMiceSettings(allSettings);
+			int count = allSettings.CountItems();
+			for (int i = 0; i < count; i++) {
+				static_cast<MouseSettings*>(allSettings.ItemAt(i))
+					->SetNaturalScrolling(naturalScrolling);
+			}
+		} else {
+			settings->SetNaturalScrolling(naturalScrolling);
+		}
+
+		be_app_messenger.SendMessage(IS_SAVE_SETTINGS);
+
+		return _PostMouseControlMessage(IS_NATURAL_SCROLLING_CHANGED,
+			mouseName);
+	}
+
+	if (settings == NULL)
+		settings = _RunningMouseSettings();
+	return reply->AddBool("natural_scrolling", settings->NaturalScrolling());
+}
